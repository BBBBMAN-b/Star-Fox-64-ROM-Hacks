+/* ======================================================================
+ * Great Fox
+ * ====================================================================== */
+
+#define CF_GF_SCALE 0.12f            /* model is ~4100 units long; this makes it ~490 */
+#define CF_GF_EYE_UP 140.0f          /* bridge camera height above the ship's center */
+#define CF_GF_EYE_BACK 40.0f         /* bridge camera distance behind the center */
+#define CF_GF_BEAM_CHARGE_FRAMES 240 /* 8 seconds to charge the big beam */
+#define CF_GF_BEAM_FRAMES 60         /* beam lasts 2 seconds */
+#define CF_GF_METER_MAX 90.0f        /* full boost gauge */
+#define CF_GF_MAX_TARGETS 5
+#define CF_GF_LASER_DAMAGE 60 /* 4x the hyper (blue) laser's 15 */
+
+static s32 sCfBeamTimer = 0;
+static s32 sCfGfShotTimer = 0;
+
+bool CustomFox_IsGreatFox(Player* player) {
+    return (player->num == 0) && (player->form == FORM_ARWING) && (CustomFox_ActiveShip() == CFSHIP_GREAT_FOX);
+}
+
+/* Bridge-view camera: above the hull, a little behind center, looking out over the bow. */
+bool CustomFox_GreatFoxCamera(Player* player) {
+    Vec3f fwd;
+    Vec3f up;
+    f32 baseZ;
+
+    if (!CustomFox_IsGreatFox(player)) {
+        return false;
+    }
+    CustomFox_ShipBasis(player, &fwd, &up);
+    if (gLevelMode == LEVELMODE_ON_RAILS) {
+        baseZ = player->trueZpos + gPathProgress;
+    } else {
+        baseZ = player->pos.z; /* all-range cameras use the raw position */
+    }
+
+    gCsCamEyeX = player->pos.x + up.x * CF_GF_EYE_UP - fwd.x * CF_GF_EYE_BACK;
+    gCsCamEyeY = player->pos.y + up.y * CF_GF_EYE_UP - fwd.y * CF_GF_EYE_BACK;
+    gCsCamEyeZ = baseZ + up.z * CF_GF_EYE_UP - fwd.z * CF_GF_EYE_BACK;
+    /* look ahead, tilted slightly down so the bow shows at the bottom of the screen */
+    gCsCamAtX = player->pos.x + up.x * (CF_GF_EYE_UP - 60.0f) + fwd.x * 3000.0f;
+    gCsCamAtY = player->pos.y + up.y * (CF_GF_EYE_UP - 60.0f) + fwd.y * 3000.0f;
+    gCsCamAtZ = baseZ + up.z * (CF_GF_EYE_UP - 60.0f) + fwd.z * 3000.0f;
+
+    Math_SmoothStepToF(&player->cam.eye.x, gCsCamEyeX, 0.5f, 1000.0f, 0.0f);
+    Math_SmoothStepToF(&player->cam.eye.y, gCsCamEyeY, 0.5f, 1000.0f, 0.0f);
+    Math_SmoothStepToF(&player->cam.eye.z, gCsCamEyeZ, 0.5f, 1000.0f, 0.0f);
+    Math_SmoothStepToF(&player->cam.at.x, gCsCamAtX, 0.5f, 1000.0f, 0.0f);
+    Math_SmoothStepToF(&player->cam.at.y, gCsCamAtY, 0.5f, 1000.0f, 0.0f);
+    Math_SmoothStepToF(&player->cam.at.z, gCsCamAtZ, 0.5f, 1000.0f, 0.0f);
+    Math_SmoothStepToF(&player->camRoll, -player->bankAngle * 0.3f, 0.1f, 1.5f, 0.0f);
+    return true;
+}
+
+/* Big ship = slow, steady handling. Called after the game sets its turn values. */
+void CustomFox_GreatFoxTurnMods(Player* player) {
+    if (CustomFox_IsGreatFox(player)) {
+        gPlayerTurnStickMod *= 0.9f; /* near-full movement so routes can be chosen */
+        gPlayerTurnRate *= 0.9f;
+    }
+}
+
+static void CustomFox_GreatFoxLaser(Player* player, Actor* target) {
+    PlayerShot* shot = CustomFox_FreeShot();
+    Vec3f d;
+    f32 len;
+    f32 speed = 400.0f / 3.0f;
+
+    if (shot == NULL) {
+        return;
+    }
+    Player_SetupArwingShot(player, shot, 0.0f, 0.0f, PLAYERSHOT_TWIN_LASER, speed);
+    shot->timer = 45;
+    if (target != NULL) {
+        d.x = target->obj.pos.x - shot->obj.pos.x;
+        d.y = (target->obj.pos.y + target->info.targetOffset) - shot->obj.pos.y;
+        d.z = target->obj.pos.z - shot->obj.pos.z;
+        len = sqrtf(SQ(d.x) + SQ(d.y) + SQ(d.z));
+        if (len > 1.0f) {
+            d.x /= len;
+            d.y /= len;
+            d.z /= len;
+            shot->vel.x = d.x * speed;
+            shot->vel.y = d.y * speed;
+            shot->vel.z = d.z * speed;
+            /* matches Player_SetupArwingShot: dir = (-cos(rx)sin(ry), sin(rx), -cos(rx)cos(ry)) */
+            shot->obj.rot.x = Math_RadToDeg(Math_Atan2F(d.y, sqrtf(SQ(d.x) + SQ(d.z))));
+            shot->obj.rot.y = Math_RadToDeg(Math_Atan2F(-d.x, -d.z));
+        }
+    }
+}
+
+/* Replaces normal shooting for the Great Fox. */
+bool CustomFox_GreatFoxShoot(Player* player) {
+    Actor* targets[CF_GF_MAX_TARGETS];
+    s32 count;
+    s32 i;
+    bool fire = false;
+
+    if (!CustomFox_IsGreatFox(player)) {
+        return false;
+    }
+
+    count = CustomFox_FindTargets(player, targets, CF_GF_MAX_TARGETS);
+    for (i = 0; i < count; i++) {
+        targets[i]->lockOnTimers[0] = 2; /* red lock-on boxes */
+    }
+
+    if (gInputPress->button & A_BUTTON) {
+        fire = true;
+        sCfGfShotTimer = 8;
+    } else if (gInputHold->button & A_BUTTON) {
+        if (--sCfGfShotTimer <= 0) {
+            fire = true;
+            sCfGfShotTimer = 8;
+        }
+    }
+
+    if (fire) {
+        if (count == 0) {
+            CustomFox_GreatFoxLaser(player, NULL);
+        } else {
+            for (i = 0; i < count; i++) {
+                CustomFox_GreatFoxLaser(player, targets[i]);
+            }
+        }
+        Player_PlaySfx(player->sfxSource, NA_SE_ARWING_TWIN_LASER2, player->num);
+        gMuzzleFlashScale[player->num] = 0.75f;
+    }
+
+    Player_SmartBomb(player);
+    return true;
+}
+
+/* Boost gauge = beam charge. Full gauge + boost button (C-Left) fires the beam. */
+static void CustomFox_GreatFoxBeamUpdate(Player* player) {
+    PlayerShot* shot;
+
+    player->boostCooldown = false;
+
+    if (sCfBeamTimer > 0) {
+        sCfBeamTimer--;
+        player->boostMeter = CF_GF_METER_MAX * sCfBeamTimer / CF_GF_BEAM_FRAMES;
+        shot = CustomFox_FreeShot();
+        if (shot != NULL) {
+            Player_SetupArwingShot(player, shot, 0.0f, 10.0f, PLAYERSHOT_GFOX_LASER, 150.0f);
+        }
+        if ((sCfBeamTimer % 10) == 0) {
+            AUDIO_PLAY_SFX(NA_SE_GREATFOX_SHOT_DEMO, player->sfxSource, 0);
+        }
+        gCameraShake = 4;
+        return;
+    }
+
+    if (CF_ON(CF_INF_BOOST)) {
+        player->boostMeter = CF_GF_METER_MAX; /* infinite boost cheat: beam is always ready */
+    }
+
+    if (player->boostMeter < CF_GF_METER_MAX) {
+        player->boostMeter += CF_GF_METER_MAX / CF_GF_BEAM_CHARGE_FRAMES;
+        if (player->boostMeter >= CF_GF_METER_MAX) {
+            player->boostMeter = CF_GF_METER_MAX;
+            AUDIO_PLAY_SFX(NA_SE_LOCK_SEARCH, gDefaultSfxSource, 4);
+        }
+    } else if (gInputPress->button & gBoostButton[player->num]) {
+        sCfBeamTimer = CF_GF_BEAM_FRAMES;
+        AUDIO_PLAY_SFX(NA_SE_GREATFOX_SHOT_DEMO, player->sfxSource, 0);
+    }
+}
+
+static s32 sCfRecenterTimer = 0;
+
+/* C-Right: glide back to the middle of the course and straighten out (on-rails levels). */
+static void CustomFox_GreatFoxRecenter(Player* player) {
+    if ((gInputPress->button & R_CBUTTONS) && (gLevelMode == LEVELMODE_ON_RAILS)) {
+        sCfRecenterTimer = 45;
+        AUDIO_PLAY_SFX(NA_SE_DECIDE, gDefaultSfxSource, 4);
+    }
+    if (sCfRecenterTimer > 0) {
+        sCfRecenterTimer--;
+        Math_SmoothStepToF(&player->pos.x, player->xPath, 0.15f, 60.0f, 0.5f);
+        Math_SmoothStepToF(&player->pos.y, player->yPath + (player->pathFloor + player->pathHeight) * 0.5f, 0.15f,
+                           40.0f, 0.5f);
+        Math_SmoothStepToF(&player->rot.y, 0.0f, 0.2f, 5.0f, 0.01f);
+        Math_SmoothStepToF(&player->rot.x, 0.0f, 0.2f, 5.0f, 0.01f);
+    }
+}
+
+/* Auto-collect: picks up every pickup within reach of the big hull (not route or warp markers). */
+void CustomFox_GreatFoxCollect(Player* player) {
+    Item* item;
+    s32 i;
+    f32 dx;
+    f32 dy;
+    f32 dz;
+
+    for (i = 0, item = gItems; i < ARRAY_COUNT(gItems); i++, item++) {
+        if ((item->obj.status != OBJ_ACTIVE) || (item->timer_4A != 0) || item->collected) {
+            continue;
+        }
+        switch (item->obj.id) {
+            case OBJ_ITEM_LASERS:
+            case OBJ_ITEM_CHECKPOINT:
+            case OBJ_ITEM_SILVER_RING:
+            case OBJ_ITEM_SILVER_STAR:
+            case OBJ_ITEM_BOMB:
+            case OBJ_ITEM_1UP:
+            case OBJ_ITEM_GOLD_RING:
+            case OBJ_ITEM_WING_REPAIR:
+                break;
+            default:
+                continue;
+        }
+        dx = item->obj.pos.x - player->pos.x;
+        dy = item->obj.pos.y - player->pos.y;
+        dz = item->obj.pos.z - player->trueZpos;
+        if ((SQ(dx) + SQ(dy) + SQ(dz)) < SQ(700.0f)) {
+            item->collected = true;
+            item->playerNum = 0;
+        }
+    }
+}
+
+/* Replaces boost, brake and barrel rolls for the Great Fox. Returns true if it handled them. */
+bool CustomFox_GreatFoxControls(Player* player) {
+    if (!CustomFox_IsGreatFox(player) || (player->csTimer != 0)) {
+        return false;
+    }
+    player->sfx.boost = player->sfx.brake = false;
+    player->boostActive = false;
+    Math_SmoothStepToF(&player->boostSpeed, 0.0f, 0.1f, 1.0f, 0.0f);
+    CustomFox_GreatFoxBeamUpdate(player);
+    CustomFox_GreatFoxRecenter(player);
+    CustomFox_GreatFoxCollect(player);
+    return true;
+}
+
+s32 CustomFox_GreatFoxDamage(s32 damage, PlayerShot* shot, bool isBoss) {
+    if ((shot->sourceId != 0) || (CustomFox_ActiveShip() != CFSHIP_GREAT_FOX)) {
+        return damage;
+    }
+    if (shot->obj.id == PLAYERSHOT_TWIN_LASER) {
+        return CF_GF_LASER_DAMAGE;
+    }
+    if ((shot->obj.id == PLAYERSHOT_GFOX_LASER) && isBoss) {
+        return 30;
+    }
+    return damage;
+}
+
+void CustomFox_GreatFoxLevelStart(void) {
+    sCfBeamTimer = 0;
+    sCfGfShotTimer = 0;
+    gPlayer[0].boostMeter = 0.0f;
+}
+
+/* Levels that leave segments D/E/F empty get them pointed at the Expansion Pak copies,
+ * so the ship models and the Great Fox beam can be drawn anywhere. */
+void CustomFox_FillEmptyShipSegments(void* scenePtr) {
+    Scene* scene = (Scene*) scenePtr;
+
+    if (!gCustomFoxShipAssetsLoaded) {
+        return;
+    }
+    if (scene->assets[0x0D - 1].start == 0) {
+        gSegments[0x0D] = K0_TO_PHYS(CF_EXP_ALLIES);
+        gSPSegment(gUnkDisp1++, 0x0D, gSegments[0x0D]);
+    }
+    if (scene->assets[0x0E - 1].start == 0) {
+        gSegments[0x0E] = K0_TO_PHYS(CF_EXP_GREAT_FOX);
+        gSPSegment(gUnkDisp1++, 0x0E, gSegments[0x0E]);
+    }
+    if (scene->assets[0x0F - 1].start == 0) {
+        gSegments[0x0F] = K0_TO_PHYS(CF_EXP_STAR_WOLF);
+        gSPSegment(gUnkDisp1++, 0x0F, gSegments[0x0F]);
+    }
+}
