+
+static void Map_CfAnyPathInput(void) {
+    PlanetId routes[3];
+    s32 n = 0;
+    s32 i;
+    s32 cur = 0;
+    u16 press = gControllerPress[gMainController].button;
+
+    if (!Map_CfAnyPathActive() || !(press & (L_JPAD | R_JPAD))) {
+        return;
+    }
+    if (sPlanets[sPrevPlanetId].dest1 != PLANET_NONE) {
+        routes[n++] = sPlanets[sPrevPlanetId].dest1;
+    }
+    if (sPlanets[sPrevPlanetId].dest2 != PLANET_NONE) {
