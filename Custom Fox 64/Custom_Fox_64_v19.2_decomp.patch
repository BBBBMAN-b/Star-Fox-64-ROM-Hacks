+static void CustomFoxMenu_DrawMisc(void) {
+    s32 i;
+    s32 row;
+    s32 opt = sCfMiscOrder[sCfMiscCursor];
+    s32 y;
+    char* value;
+    s32 line = 0;
+
+    CustomFoxMenu_DrawPanel(CF_MISC_TOP - 6, CF_MISC_TOP + CFMISC_MAX * CF_MISC_ROW_PITCH + 2);
+    if (sCfAnim < 1.0f) {
+        return;
+    }
+
+    y = CF_MISC_TOP + sCfMiscCursor * CF_MISC_ROW_PITCH;
+    Graphics_FillRectangle(&gMasterDisp, CF_PANEL_LEFT + 4, y - 2, CF_PANEL_RIGHT - 4, y + 9, 60, 40, 170, 220);
+
+    RCP_SetupDL(&gMasterDisp, SETUPDL_83);
+    for (row = 0; row < CFMISC_MAX; row++) {
+        i = sCfMiscOrder[row];
+        y = CF_MISC_TOP + row * CF_MISC_ROW_PITCH;
+        if (!CustomFox_MiscUnlocked(i)) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, (row == sCfMiscCursor) ? 170 : 110, (row == sCfMiscCursor) ? 170 : 110,
+                            (row == sCfMiscCursor) ? 120 : 130, 255);
+        } else if (row == sCfMiscCursor) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 0, 255);
+        } else if (sCfMiscReady[i]) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+        } else {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 130, 130, 150, 255);
+        }
+        Graphics_DisplaySmallText(CF_PANEL_LEFT + 10, y, 1.0f, 1.0f, sCfMiscNames[i]);
+
+        if (sCfMiscEmuOnly[i]) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 120, 0, 255);
+            Graphics_DisplaySmallText(CF_PANEL_LEFT + 10 + Graphics_GetSmallTextWidth(sCfMiscNames[i]) + 4, y, 1.0f,
+                                      1.0f, "!");
+        }
+
+        if (!sCfMiscReady[i]) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 130, 130, 150, 255);
+            value = "SOON";
+        } else if (!CustomFox_MiscUnlocked(i)) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 110, 110, 130, 255);
+            value = "LOCKED";
+        } else if (gCustomFoxMisc[i]) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 60, 255, 60, 255);
+            value = "ON";
+        } else {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 140, 140, 160, 255);
+            value = "OFF";
+        }
+        Graphics_DisplaySmallText(CF_PANEL_RIGHT - 44, y, 1.0f, 1.0f, value);
+    }
+
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+    Graphics_DisplaySmallText(CF_PANEL_LEFT + 2, CF_MISC_TOP - 16, 1.0f, 1.0f, "MISC - GAME MODES");
+
+    /* description */
+    y = CF_MISC_TOP + CFMISC_MAX * CF_MISC_ROW_PITCH + 14;
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+    for (i = 0; i < 3; i++) {
+        if (sCfMiscDesc[opt][i][0] != '\0') {
+            CustomFoxMenu_CenterText(y + line * 12, sCfMiscDesc[opt][i]);
+            line++;
+        }
+    }
+    y += 3 * 12 + 4;
+    if (!CustomFox_MiscUnlocked(opt)) {
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 90, 90, 255);
+        CustomFoxMenu_CenterText(y, "LOCKED - TO UNLOCK:");
+        CustomFoxMenu_CenterText(y + 11, sCfMiscHint[opt]);
+    } else if (sCfMiscEmuOnly[opt]) {
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 120, 0, 255);
+        CustomFoxMenu_CenterText(y, "! NOT FOR ORIGINAL N64 HARDWARE");
+        CustomFoxMenu_CenterText(y + 11, "NEEDS AN EMULATOR WITH EXTRA RAM");
+    } else if (opt == CFMISC_ANDROSS_REVENGE) {
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+        CustomFoxMenu_CenterText(y, "TIP: THE ARWING MK2 IS RECOMMENDED");
+    } else if (((opt == CFMISC_MORE_ENEMIES) || (opt == CFMISC_TRIPLE_ENEMIES)) &&
+               (osMemSize < 0x800000)) {
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 120, 0, 255);
+        CustomFoxMenu_CenterText(y, "NEEDS THE EXPANSION PAK");
+    } else if (!sCfMiscReady[opt]) {
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 130, 130, 150, 255);
+        CustomFoxMenu_CenterText(y, "COMING IN A FUTURE UPDATE");
+    }
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+    CustomFoxMenu_CenterText(222, "A:TOGGLE   B:BACK");
+}
