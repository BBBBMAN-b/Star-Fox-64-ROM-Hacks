+static void CustomFoxMenu_DrawCheats(void) {
+    s32 i;
+    s32 row;
+    s32 y;
+    s32 trackTop;
+    s32 trackBot;
+    s32 thumbTop;
+    s32 thumbLen;
+    s32 numOn = 0;
+    char* value;
+
+    CustomFoxMenu_DrawPanel(CF_LIST_TOP - 6, CF_LIST_TOP + CF_VISIBLE_ROWS * CF_ROW_PITCH + 2);
+
+    if (sCfAnim < 1.0f) {
+        return;
+    }
+
+    /* highlight bar */
+    row = sCfCheatCursor - sCfScroll;
+    y = CF_LIST_TOP + row * CF_ROW_PITCH;
+    Graphics_FillRectangle(&gMasterDisp, CF_PANEL_LEFT + 4, y - 2, CF_PANEL_RIGHT - 12, y + 9, 60, 40, 170, 220);
+
+    /* scroll bar */
+    trackTop = CF_LIST_TOP - 2;
+    trackBot = CF_LIST_TOP + CF_VISIBLE_ROWS * CF_ROW_PITCH - 3;
+    thumbLen = (trackBot - trackTop) * CF_VISIBLE_ROWS / CF_MAX;
+    thumbTop = trackTop + (trackBot - trackTop - thumbLen) * sCfScroll / (CF_MAX - CF_VISIBLE_ROWS);
+    Graphics_FillRectangle(&gMasterDisp, CF_PANEL_RIGHT - 8, trackTop, CF_PANEL_RIGHT - 6, trackBot, 40, 40, 90, 255);
+    Graphics_FillRectangle(&gMasterDisp, CF_PANEL_RIGHT - 8, thumbTop, CF_PANEL_RIGHT - 6, thumbTop + thumbLen, 160,
+                           160, 255, 255);
+
+    RCP_SetupDL(&gMasterDisp, SETUPDL_83);
+
+    for (i = 0; i < CF_MAX; i++) {
+        if (gCustomFox[i]) {
+            numOn++;
+        }
+    }
+
+    for (row = 0; row < CF_VISIBLE_ROWS; row++) {
+        if (sCfScroll + row >= CF_MAX) {
+            break;
+        }
+        i = sCfCheatOrder[sCfScroll + row];
+        y = CF_LIST_TOP + row * CF_ROW_PITCH;
+
+        if (!CustomFox_CheatUnlocked(i)) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, (sCfScroll + row == sCfCheatCursor) ? 170 : 110,
+                            (sCfScroll + row == sCfCheatCursor) ? 170 : 110,
+                            (sCfScroll + row == sCfCheatCursor) ? 120 : 130, 255);
+        } else if (sCfScroll + row == sCfCheatCursor) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 0, 255);
+        } else {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+        }
+        Graphics_DisplaySmallText(CF_PANEL_LEFT + 10, y, 1.0f, 1.0f, sCfCheatNames[i]);
+
+        if (!CustomFox_CheatUnlocked(i)) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 110, 110, 130, 255);
+            value = "LOCKED";
+        } else if (gCustomFox[i]) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 60, 255, 60, 255);
+            value = "ON";
+        } else {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 140, 140, 160, 255);
+            value = "OFF";
+        }
+        Graphics_DisplaySmallText(CF_PANEL_RIGHT - 44, y, 1.0f, 1.0f, value);
+    }
+
+    /* page title */
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+    Graphics_DisplaySmallText(CF_PANEL_LEFT + 2, CF_LIST_TOP - 16, 1.0f, 1.0f, "CHEATS");
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 160, 160, 255, 255);
+    Graphics_Printf("%d OF %d ON", numOn, CF_MAX);
+    Graphics_DisplaySmallText(CF_PANEL_RIGHT - 2 - Graphics_GetSmallTextWidth(gGfxPrintBuffer), CF_LIST_TOP - 16,
+                              1.0f, 1.0f, gGfxPrintBuffer);
+
+    /* description + controls */
+    if (CustomFox_CheatUnlocked(sCfCheatOrder[sCfCheatCursor])) {
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+        CustomFoxMenu_CenterText(196, sCfCheatDesc[sCfCheatOrder[sCfCheatCursor]]);
+    } else {
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 90, 90, 255);
+        CustomFoxMenu_CenterText(196, "LOCKED - BEAT ANDROSS ON NORMAL");
+    }
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+    CustomFoxMenu_CenterText(212, "A:TOGGLE   R:ALL ON-OFF   B:BACK");
+}
