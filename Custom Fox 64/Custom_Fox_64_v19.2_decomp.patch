+static void CustomFoxMenu_UpdateMisc(void) {
+    u16 press = gControllerPress[gMainController].button;
+
+    s32 opt;
+
+    if (CustomFoxMenu_MoveCursor(&sCfMiscCursor, CFMISC_MAX - 1)) {
+        AUDIO_PLAY_SFX(NA_SE_CURSOR, gDefaultSfxSource, 4);
+    }
+    opt = sCfMiscOrder[sCfMiscCursor];
+    if (press & (A_BUTTON | L_JPAD | R_JPAD)) {
+        if (sCfMiscReady[opt] && CustomFox_MiscUnlocked(opt)) {
+            gCustomFoxMisc[opt] ^= 1;
+            if (gCustomFoxMisc[opt]) {
