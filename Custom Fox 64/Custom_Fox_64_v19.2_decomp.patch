+extern s32 gCfGreenShieldFx;
+extern Vec3f gCfLockMarks[12];
+extern s32 gCfLockMarkCount;
+extern u8 gCfActorClone[60]; /* frames left of the green shield bubble colour */
+bool CustomFox_MoreEnemiesOn(void);
+bool CustomFox_VehicleUpgrades(void);
+bool CustomFox_SkipCutscenes(void);
+void CustomFox_SkipOutro(Player* player);
+bool CustomFox_SkipCredits(void);
+s32 CustomFox_MarineTargets(Player* player, Actor** out);
+void CustomFox_SetShotTarget(PlayerShot* shot, Actor* target);
+f32 CustomFox_TorpedoFxScale(void);
+void CustomFox_ActorInit(Actor* actor);
+void CustomFox_EventSpawned(Actor* actor);
+void CustomFox_MoreEnemiesUpdate(void);
+void CustomFox_MoreLevelActor(ObjectInit* objInit);
+bool CustomFox_CloneSkipOp(Actor* actor, s32 opcode);
+s32 CustomFox_BossHealthMult(void);
+s32 CustomFox_BossDamage(s32 damage);
+s32 CustomFox_BossBarSegment(s32 bar, s32* segBar);
+bool CustomFox_BossBarHidden(void);
+void CustomFox_AllyFloor(void);
