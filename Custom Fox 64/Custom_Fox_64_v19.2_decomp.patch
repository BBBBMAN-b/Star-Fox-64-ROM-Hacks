+/* Custom Fox 64: Vehicle Upgrades torpedo, from any free slot 11-15, homing on its own target */
+static PlayerShot* Aquas_CfTorpedo(Player* player, Actor* target) {
+    s32 i;
+    PlayerShot* shot;
+
+    for (i = ARRAY_COUNT(gPlayerShots) - 1; i >= 11; i--) {
+        shot = &gPlayerShots[i];
+        if (shot->obj.status == SHOT_FREE) {
+            Player_SetupArwingShot(player, shot, 0.0f, 0.0f, PLAYERSHOT_LOCK_ON, 50.0f);
+            AUDIO_PLAY_SFX(NA_SE_MAR_BOMB_SHOT, shot->sfxSource, 0);
+            CustomFox_SetShotTarget(shot, target);
+            D_i3_801C4190[5] = i + 1;
+            D_i3_801C4454 = 300;
+            D_i3_801C4458 = -100.0f;
+            D_i3_801C445C = 0.1f;
+            gLight3Brightness = 1.0f;
+            return shot;
+        }
+    }
+    return NULL;
+}
+
+static s32 sCfMarLaserTimer = 0;
+
+static void Aquas_CfUpgradedShoot(Player* player) {
+    Actor* targets[3];
+    s32 n = CustomFox_MarineTargets(player, targets);
+    s32 i;
+    bool torp = false;
+
+    if (gInputPress->button & A_BUTTON) {
+        Aquas_BlueMarineLaser(player);
+        sCfMarLaserTimer = 4;
+    } else if (gInputHold->button & A_BUTTON) {
+        if (--sCfMarLaserTimer <= 0) {
+            Aquas_BlueMarineLaser(player);
+            sCfMarLaserTimer = 4;
+        }
+    }
+
+    /* hold B: a new volley as soon as the last one is gone (torpedoes also travel 50% faster) */
+    if (gInputHold->button & B_BUTTON) {
+        torp = true;
+        for (i = 11; i < ARRAY_COUNT(gPlayerShots); i++) {
+            if ((gPlayerShots[i].obj.status != SHOT_FREE) && (gPlayerShots[i].obj.id == PLAYERSHOT_LOCK_ON)) {
+                torp = false;
+            }
+        }
+    }
+    if (torp) {
+        if (n == 0) {
+            if (Aquas_CfTorpedo(player, NULL) != NULL) {
+                if (D_i3_801C4190[0] != 0) {
+                    D_i3_801C4190[3] = 1;
+                }
+            }
+        } else {
+            for (i = 0; i < n; i++) {
+                Aquas_CfTorpedo(player, targets[i]);
+            }
+        }
+    }
+}
