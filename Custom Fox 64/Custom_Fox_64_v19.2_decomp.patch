+#ifndef CUSTOMFOX_H
+#define CUSTOMFOX_H
+
+/*
+ * Custom Fox 64
+ * In-game cheat menu added to the main menu ("Custom Fox 64" card).
+ * Cheat flags live in main RAM so every overlay can read them, and
+ * are stored in unused bytes of the save file so they survive power off.
+ */
+
+typedef enum CustomFoxCheat {
+    CF_INF_BOMBS,
+    CF_INF_LIVES,
+    CF_NOCLIP,
+    CF_MAX_LASER,
+    CF_INF_HEALTH,
+    CF_INF_BOOST,
+    CF_ALLY_HEALTH,
+    CF_ALLY_NOCLIP,
+    CF_START_150_HITS,
+    CF_MAX_HITS,
+    CF_CHARGED_LASER,
+    CF_RAPID_CHARGED,
+    CF_BOMB_4X,
+    CF_DAMAGE_2X,
+    CF_DAMAGE_4X,
+    CF_MULTI_LOCK_3,
+    CF_MULTI_LOCK_5,
+    CF_MULTI_LOCK_7,
+    CF_MULTI_LOCK_12,
+    CF_ALLY_LASERS,     /* Falco, Slippy, Peppy (and Katt, Bill) fire level 3 twin lasers */
+    CF_KATT_BILL_SHIPS, /* Katt and Bill fly with their Ship Swap upgrades */
+    CF_RAPID_AUTO,      /* hold A for rapid fire, let go and the laser charges itself */
+    CF_UNLOCK_ALL,      /* unlocks everything (Expert mode and Expert sound for now) */
+    CF_AUTO_COLLECT,    /* pick up every item you fly near (the Great Fox ability) */
+    CF_MAX
+} CustomFoxCheat;
+
+typedef enum CustomFoxShip {
+    CFSHIP_ARWING,
+    CFSHIP_WOLFEN,
+    CFSHIP_WOLFEN_II,
+    CFSHIP_KATT,
+    CFSHIP_BILL,
+    CFSHIP_GREAT_FOX,
+    CFSHIP_ARWING_MK2,
+    CFSHIP_KATT_MK2, /* Katt's fighter with the purple double-damage lasers */
+    CFSHIP_BILL_MK2, /* Bill's fighter with 1/3 damage and bomb refills */
+    CFSHIP_MAX
+} CustomFoxShip;
+
+typedef enum CustomFoxMisc {
+    CFMISC_HARD_MODE,       /* adds the HARD difficulty after EXPERT */
+    CFMISC_ANDROSS_REVENGE, /* planned: ANDROSS'S REVENGE difficulty */
+    CFMISC_MORE_ENEMIES,    /* double enemies */
+    CFMISC_VEHICLES,        /* Blue Marine and Landmaster upgrades (every mode) */
+    CFMISC_SKIP_CUTSCENES,  /* START skips mission intro/outro cutscenes and the end credits */
+    CFMISC_TRIPLE_ENEMIES,  /* triple enemies (bits stay in save order; the menu has its own order) */
+    CFMISC_ANY_PATH,        /* choose any route on the map after a mission */
+    CFMISC_MAX
+} CustomFoxMisc;
+
+/* Campaign difficulty picked on the main menu card (on top of gExpertMode). */
+typedef enum CustomFoxDifficulty {
+    CFDIFF_NONE,
+    CFDIFF_HARD,
+    CFDIFF_ANDROSS_REVENGE
+} CustomFoxDifficulty;
+
+#define CFSHIP_SELECTABLE CFSHIP_MAX /* ships below this index can be picked */
+
+#define CF_SAVE_MAGIC 0xCF
+
+#define CF_TEST_DEFAULTS 0 /* test builds only (must be 0 for release): helper cheats + debug text */
+
+extern u8 gCustomFox[CF_MAX];
+extern u8 gCustomFoxShip;            /* ship chosen in the Ship Swap menu */
+extern bool gCustomFoxShipAssetsLoaded;
+extern u8 gCustomFoxMisc[CFMISC_MAX];  /* Misc page toggles (saved) */
+extern u8 gCustomFoxDifficulty;        /* CustomFoxDifficulty of the current campaign */ /* ship models copied into Expansion Pak RAM */
+
+/* Cheats are disabled in Versus mode so multiplayer stays fair. */
+/* Unlock progress (saved in padEE[6..7]) */
+typedef enum CustomFoxProgress {
+    CFP_ANDROSS_NORMAL,  /* beat Andross on Normal (or harder) */
+    CFP_ANDROSS_EXPERT,
+    CFP_ANDROSS_MASTER,
+    CFP_ANDROSS_REVENGE,
+    CFP_BILL,            /* saved the Katina base with Bill (Mission Accomplished) */
+    CFP_BILL_EXPERT,
+    CFP_KATT,            /* cleared Zoness, where Katt first shows up */
+    CFP_KATT_EXPERT,
+    CFP_WOLF,            /* beat Star Wolf on Fortuna (Mission Accomplished) */
+    CFP_WOLF_EXPERT,
+    CFP_MAX
+} CustomFoxProgress;
+u32 CustomFox_Progress(void);
+bool CustomFox_AllNormalMissions(void);
+bool CustomFox_CheatUnlocked(s32 cheat);
+bool CustomFox_ShipUnlocked(s32 ship);
+bool CustomFox_MiscUnlocked(s32 misc);
+void CustomFox_ApplyLocks(void);
+void CustomFox_RecordAndross(void);
+void CustomFox_SetProgress(s32 bit);
+void CustomFox_RecordLevel(s32 level, s32 missionStatus);
+
+#define CF_ON(cheat) ((gCustomFox[cheat] != 0) && !gVersusMode)
