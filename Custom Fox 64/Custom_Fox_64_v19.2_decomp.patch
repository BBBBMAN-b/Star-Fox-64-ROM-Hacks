+void CustomFox_EnemyShotFired(s32 kind, s32 objId, f32* args);
+void CustomFox_AllRangeFired(Actor* actor);
+void CustomFox_AllRangeAggro(Actor* actor, f32* fireChance, u8* fireMask, f32* fireRange);
+bool CustomFox_FastEnemyShots(void);
+void CustomFox_OmegaReset(void);
+void CustomFox_OmegaDraw(void);
+bool CustomFox_OmegaPierce(Actor* actor);
+extern bool gCfOmegaHitting;
+extern s32 gCfOmegaHits;
+extern u32 gCfOmegaCost;
+extern u32 gCfOmegaCostB;
+void CustomFox_AutoCollect(Player* player);
+
+/* Boss HP subtraction sites use this: "hp -= CF_BOSS_DMG(this->damage);" */
+#define CF_BOSS_DMG(damage) CustomFox_BossDamage(damage)
+
+/* Boss attack cooldowns: "timer = CF_BOSS_RATE(150);" attacks 1.5x as often on Hard, 2x on Revenge */
+s32 CustomFox_BossRate(s32 frames);
+#define CF_BOSS_RATE(frames) CustomFox_BossRate(frames)
+/* Ally fire gaps use the same scaling: 1.5x as often on Master, 2x on Andross's Revenge */
+#define CF_ALLY_RATE(frames) CustomFox_BossRate(frames)
