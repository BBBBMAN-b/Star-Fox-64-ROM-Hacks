+/* ----------------------------------------------------------------------
+ * Main Game card: NORMAL / EXPERT (when unlocked) / HARD MODE (Misc toggle)
+ * ---------------------------------------------------------------------- */
+typedef enum CfDiffEntry {
+    CFDE_NORMAL,
+    CFDE_EXPERT,
+    CFDE_HARD,
+    CFDE_REVENGE
+} CfDiffEntry;
+
+static s32 CustomFoxMenu_DiffEntries(s32* list) {
+    s32 n = 0;
+
+    list[n++] = CFDE_NORMAL;
+    if (sExpertModesEnabled) {
+        list[n++] = CFDE_EXPERT;
+    }
+    if (gCustomFoxMisc[CFMISC_HARD_MODE]) {
+        list[n++] = CFDE_HARD;
+    }
+    if (gCustomFoxMisc[CFMISC_ANDROSS_REVENGE]) {
+        list[n++] = CFDE_REVENGE;
+    }
+    return n;
+}
+
+s32 CustomFoxMenu_DiffCount(void) {
+    s32 list[4];
+
+    return CustomFoxMenu_DiffEntries(list);
+}
+
+void CustomFoxMenu_ApplyDiffCard(void) {
+    s32 list[4];
+    s32 n = CustomFoxMenu_DiffEntries(list);
+    OptionCardTexture* tex = &sOptionCardList[OPTION_MAP].tex;
+
+    if (sExpertModeCursor >= n) {
+        sExpertModeCursor = n - 1;
+    }
+    if (sExpertModeCursor < 0) {
+        sExpertModeCursor = 0;
+    }
+    gExpertMode = false;
+    gCustomFoxDifficulty = CFDIFF_NONE;
+
+    switch (list[sExpertModeCursor]) {
+        case CFDE_EXPERT:
+            tex->texture = aExpertCardTex;
+            tex->width = 80;
+            tex->height = 12;
+            tex->xPos = 125.0f;
+            tex->yPos = 43.0f;
+            gExpertMode = true;
+            break;
+        case CFDE_HARD:
+            tex->texture = (u8*) aCfHardCardTex;
+            tex->width = aCfHardCardTex_W;
+            tex->height = 12;
+            tex->xPos = 160.0f - aCfHardCardTex_TW / 2;
+            tex->yPos = 42.0f;
+            gCustomFoxDifficulty = CFDIFF_HARD;
+            break;
+        case CFDE_REVENGE:
+            tex->texture = (u8*) aCfRevengeCardTex;
+            tex->width = aCfRevengeCardTex_W;
+            tex->height = 12;
+            tex->xPos = 160.0f - aCfRevengeCardTex_TW / 2;
+            tex->yPos = 42.0f;
+            gCustomFoxDifficulty = CFDIFF_ANDROSS_REVENGE;
+            break;
+        default:
+            tex->texture = aMainGameCardTex;
+            tex->width = 72;
+            tex->height = 12;
+            tex->xPos = 124.0f;
+            tex->yPos = 42.0f;
+            break;
+    }
+}
