+/* Custom Fox 64 (Andross's Revenge): every 3rd time the brain warps away, its eyes grow back. */
+static s32 sAndCfWarps = 0;
+
+static void Andross_CfRegrowEyes(AndBrain* this) {
+    s32 i;
+
+    if (!CustomFox_IsRevenge()) {
+        return;
+    }
+    sAndCfWarps++;
+    if ((sAndCfWarps % 3) != 0) {
+        return;
+    }
+    for (i = 10; i < 12; i++) {
+        if ((gActors[i].obj.status != OBJ_FREE) && (gActors[i].obj.id == OBJ_ACTOR_ALLRANGE)) {
+            return; /* an eye is still alive */
+        }
+    }
+    for (i = 10; i < 12; i++) {
+        if (gActors[i].obj.status != OBJ_FREE) {
+            Object_Kill(&gActors[i].obj, gActors[i].sfxSource); /* brain waste in the eye slots */
+        }
+    }
+    Andross_AndBrainEyes_Setup(this);
+    this->swork[5] = 60; /* hold them at the brain for a moment, then they fly out */
+    this->state = 1;
+    this->timer_050 = 50;
+    this->fwork[1] = 50.0f;
+    AUDIO_PLAY_SFX(NA_SE_VO_ANDROSS_LAUGH, this->sfxSource, 4);
+}
