+static void CustomFoxMenu_DrawShipSwap(void) {
+    s32 i;
+    s32 y;
+    bool available;
+
+    CustomFoxMenu_DrawPanel(CF_LIST_TOP - 6, 218);
+    if (sCfAnim < 1.0f) {
+        return;
+    }
+
+    y = CF_LIST_TOP + 2 + sCfShipCursor * CF_SHIP_ROW_PITCH;
+    Graphics_FillRectangle(&gMasterDisp, CF_PANEL_LEFT + 4, y - 1, 180, y + 8, 60, 40, 170, 220);
+
+    sCfPreviewRot += 3.0f;
+    if (sCfPreviewRot >= 360.0f) {
+        sCfPreviewRot -= 360.0f;
+    }
+    CustomFoxMenu_DrawShipPreview(sCfShipOrder[sCfShipCursor]);
+
+    RCP_SetupDL(&gMasterDisp, SETUPDL_83);
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+    Graphics_DisplaySmallText(CF_PANEL_LEFT + 2, CF_LIST_TOP - 16, 1.0f, 1.0f, "SHIP SWAP");
+
+    for (i = 0; i < CFSHIP_MAX; i++) {
+        s32 ship = sCfShipOrder[i];
+
+        y = CF_LIST_TOP + 2 + i * CF_SHIP_ROW_PITCH;
+        available = (ship < CFSHIP_SELECTABLE) && ((ship == CFSHIP_ARWING) || gCustomFoxShipAssetsLoaded) &&
+                    CustomFox_ShipUnlocked(ship);
+        if (ship == gCustomFoxShip) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 60, 255, 60, 255);
+            Graphics_DisplaySmallText(CF_PANEL_LEFT + 8, y, 1.0f, 1.0f, "-");
+        } else if (!available) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, (i == sCfShipCursor) ? 170 : 110, (i == sCfShipCursor) ? 170 : 110,
+                            (i == sCfShipCursor) ? 120 : 130, 255);
+        } else if (i == sCfShipCursor) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 0, 255);
+        } else {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+        }
+        Graphics_DisplaySmallText(CF_PANEL_LEFT + 18, y, 1.0f, 1.0f, sCfShipNames[ship]);
+    }
+
+    {
+        s32 ship = sCfShipOrder[sCfShipCursor];
+
+        s32 lines = 2; /* the ability or unlock lines */
+        s32 pitch;
+
+        for (i = 0; i < 5; i++) {
+            if (sCfShipFlavor[ship][i][0] != '\0') {
+                lines++;
+            }
+        }
+        pitch = (lines > 6) ? 10 : 11; /* long descriptions get packed tighter */
+        y = (lines > 6) ? 148 : 150;
+        gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+        for (i = 0; i < 5; i++) {
+            if (sCfShipFlavor[ship][i][0] != '\0') {
+                CustomFoxMenu_CenterText(y, sCfShipFlavor[ship][i]);
+                y += pitch;
+            }
+        }
+        if (!gCustomFoxShipAssetsLoaded && (ship != CFSHIP_ARWING)) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 120, 0, 255);
+            CustomFoxMenu_CenterText(y, "NEEDS AN EXPANSION PAK");
+        } else if (!CustomFox_ShipUnlocked(ship)) {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 90, 90, 255);
+            CustomFoxMenu_CenterText(y, "LOCKED - TO UNLOCK:");
+            CustomFoxMenu_CenterText(y + pitch, sCfShipHint[ship]);
+        } else {
+            gDPSetPrimColor(gMasterDisp++, 0, 0, 120, 200, 255, 255);
+            for (i = 0; i < 2; i++) {
+                if (sCfShipAbility[ship][i][0] != '\0') {
+                    CustomFoxMenu_CenterText(y, sCfShipAbility[ship][i]);
+                    y += pitch;
+                }
+            }
+        }
+    }
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+    CustomFoxMenu_CenterText(222, "A:SELECT   B:BACK");
+}
+
+static void CustomFoxMenu_DrawComingSoon(char* title) {
+    CustomFoxMenu_DrawPanel(70, 160);
+    if (sCfAnim < 1.0f) {
+        return;
+    }
+    RCP_SetupDL(&gMasterDisp, SETUPDL_83);
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 200, 0, 255);
+    CustomFoxMenu_CenterText(88, title);
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+    CustomFoxMenu_CenterText(110, "COMING IN THE NEXT UPDATE");
+    gDPSetPrimColor(gMasterDisp++, 0, 0, 160, 160, 255, 255);
+    CustomFoxMenu_CenterText(140, "B:BACK");
+}
+
+void CustomFoxMenu_Draw(void) {
+    s32 i;
+    OptionCardFrame frame;
+    OptionCardTexture tex;
+    ArwingCursorPos cursor;
+
+    Option_DrawMenuLabel();
+
+    switch (sCfState) {
+        case CFMENU_HUB:
+            Option_Menu_Push();
+            for (i = 0; i < 3; i++) {
+                frame.x = 0.0f;
+                frame.y = sCfHubFrameY[i];
+                frame.z = 0.0f;
+                frame.xScale = 0.4f * sCfAnim;
+                frame.yScale = 0.21f;
+                if (frame.xScale > 0.01f) {
+                    Option_DrawMenuCard(frame);
+                }
+            }
+            if (sCfAnim >= 1.0f) {
+                cursor.x = -40.0f;
+                cursor.y = sCfHubCursorY[sCfHubCursor];
+                cursor.range = 80.0f;
+                Option_DrawMenuArwing(cursor);
+            }
+            Matrix_Pop(&gGfxMatrix);
+
+            for (i = 0; i < 3; i++) {
+                tex = sCfHubTex[i];
+                tex.xScale = sCfAnim;
+                tex.xPos = 160.0f - (160.0f - tex.xPos) * sCfAnim;
+                Option_DrawCardLabel(tex);
+            }
+
+            if (sCfAnim >= 1.0f) {
+                RCP_SetupDL(&gMasterDisp, SETUPDL_83);
+                gDPSetPrimColor(gMasterDisp++, 0, 0, 255, 255, 255, 255);
+                Lib_TextureRect_IA8(&gMasterDisp, aBtoCancelTex, 96, 10, 166.0f, 213.0f, 1.0f, 1.0f);
+            }
+            break;
+
+        case CFMENU_CHEATS:
+            CustomFoxMenu_DrawCheats();
+            break;
+
+        case CFMENU_SHIPSWAP:
+            CustomFoxMenu_DrawShipSwap();
+            break;
+
+        case CFMENU_MISC:
+            CustomFoxMenu_DrawMisc();
+            break;
+    }
+}
