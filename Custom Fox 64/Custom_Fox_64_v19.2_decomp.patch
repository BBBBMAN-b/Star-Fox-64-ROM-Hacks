+/* Up/down from either the stick or the D-pad. Returns true if the cursor moved. */
+static bool CustomFoxMenu_MoveCursor(s32* cursor, s32 max) {
+    s32 prev = *cursor;
+    u16 press = gControllerPress[gMainController].button;
+
+    Option_Input_MoveCursor_Y(cursor, max, true, 0, 20, 5, 4, gMainController, &sCfStick);
+
+    if (press & U_JPAD) {
+        (*cursor)--;
+        if (*cursor < 0) {
+            *cursor = max;
+        }
+    } else if (press & D_JPAD) {
+        (*cursor)++;
+        if (*cursor > max) {
+            *cursor = 0;
+        }
+    }
+    return prev != *cursor;
+}
