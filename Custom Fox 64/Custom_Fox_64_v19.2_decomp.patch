+/* ----------------------------------------------------------------------
+ * Targeting (Great Fox auto-lock and multi-lock charged shots)
+ * ---------------------------------------------------------------------- */
+
+/* Forward direction of the ship, same rotation the game uses to fire lasers. */
+static void CustomFox_ShipBasis(Player* player, Vec3f* fwd, Vec3f* up) {
+    Vec3f src;
+
+    Matrix_RotateY(gCalcMatrix, (player->yRot_114 + player->rot.y + 180.0f) * M_DTOR, MTXF_NEW);
+    Matrix_RotateX(gCalcMatrix, -((player->xRot_120 + player->rot.x) * M_DTOR), MTXF_APPLY);
+    src.x = 0.0f;
+    src.y = 0.0f;
+    src.z = 1.0f;
+    Matrix_MultVec3fNoTranslate(gCalcMatrix, &src, fwd);
+    src.y = 1.0f;
+    src.z = 0.0f;
+    Matrix_MultVec3fNoTranslate(gCalcMatrix, &src, up);
+}
+
+/* Up to `max` enemies in front of the ship, nearest first. Returns how many were found. */
+static s32 CustomFox_FindTargets(Player* player, Actor** out, s32 max) {
+    Vec3f fwd;
+    Vec3f up;
+    Vec3f d;
+    f32 along;
+    f32 side;
+    f32 dist[CF_MAX_MULTI_LOCK];
+    s32 count = 0;
+    s32 i;
+    s32 j;
+    s32 k;
+    Actor* actor;
+
+    if (max > CF_MAX_MULTI_LOCK) {
+        max = CF_MAX_MULTI_LOCK;
+    }
+    CustomFox_ShipBasis(player, &fwd, &up);
+
+    for (i = 0, actor = &gActors[0]; i < ARRAY_COUNT(gActors); i++, actor++) {
+        if ((actor->obj.status != OBJ_ACTIVE) || (actor->info.targetOffset == 0.0f) || CustomFox_IsAlly(actor)) {
+            continue;
+        }
+        d.x = actor->obj.pos.x - player->pos.x;
+        d.y = (actor->obj.pos.y + actor->info.targetOffset) - player->pos.y;
+        d.z = actor->obj.pos.z - player->trueZpos;
+        along = d.x * fwd.x + d.y * fwd.y + d.z * fwd.z;
+        if ((along < 100.0f) || (along > 9000.0f)) {
+            continue;
+        }
+        d.x -= fwd.x * along;
+        d.y -= fwd.y * along;
+        d.z -= fwd.z * along;
+        side = sqrtf(SQ(d.x) + SQ(d.y) + SQ(d.z));
+        if (side > (along * 0.8f + 500.0f)) {
+            continue;
+        }
+        for (j = 0; j < count; j++) {
+            if (along < dist[j]) {
+                break;
+            }
+        }
+        if (j >= max) {
+            continue;
+        }
+        if (count < max) {
+            count++;
+        }
+        for (k = count - 1; k > j; k--) {
+            out[k] = out[k - 1];
+            dist[k] = dist[k - 1];
+        }
+        out[j] = actor;
+        dist[j] = along;
+    }
+    return count;
+}
+
+static PlayerShot* CustomFox_FreeShot(void) {
+    s32 i;
+
+    for (i = 0; i < 15; i++) {
+        if (gPlayerShots[i].obj.status == SHOT_FREE) {
+            return &gPlayerShots[i];
+        }
+    }
+    return NULL;
+}
+
+/* How many targets the charged shot locks: highest multi-lock cheat, or 3 for the MK2. */
+s32 CustomFox_MultiLockCount(void) {
+    s32 n = 0;
+
+    if (gVersusMode) {
+        return 0;
+    }
+    if (CF_ON(CF_MULTI_LOCK_12)) {
+        n = 12;
+    } else if (CF_ON(CF_MULTI_LOCK_7)) {
+        n = 7;
+    } else if (CF_ON(CF_MULTI_LOCK_5)) {
+        n = 5;
+    } else if (CF_ON(CF_MULTI_LOCK_3)) {
+        n = 3;
+    }
+    if ((CustomFox_ActiveShip() == CFSHIP_ARWING_MK2) && (n < 3)) {
+        n = 3;
+    }
+    return n;
+}
+
+/* While charging, lock targets one after another (they stay locked) and show the red boxes. */
+void CustomFox_MultiLockUpdate(Player* player) {
+    Actor* found[CF_MAX_MULTI_LOCK];
+    s32 max = CustomFox_MultiLockCount();
+    s32 count;
+    s32 i;
+    s32 j;
+    s32 k;
+
+    /* drop targets that were destroyed */
+    for (i = 0, k = 0; i < sCfLockedCount; i++) {
+        if (sCfLocked[i]->obj.status == OBJ_ACTIVE) {
+            sCfLocked[k++] = sCfLocked[i];
+        }
+    }
+    sCfLockedCount = k;
+
+    count = CustomFox_FindTargets(player, found, max);
+    for (i = 0; (i < count) && (sCfLockedCount < max); i++) {
+        for (j = 0; j < sCfLockedCount; j++) {
+            if (sCfLocked[j] == found[i]) {
+                break;
+            }
+        }
+        if (j == sCfLockedCount) {
+            sCfLocked[sCfLockedCount++] = found[i];
+            Object_PlayerSfx(player->sfxSource, NA_SE_LOCK_ON, player->num);
+        }
+    }
+    for (i = 0; i < sCfLockedCount; i++) {
+        sCfLocked[i]->lockOnTimers[player->num] = 20;
+    }
+}
+
+static void CustomFox_SetupChargedShot(Player* player, PlayerShot* shot, Actor* target) {
+    if (player->form == FORM_ARWING) {
+        Player_SetupArwingShot(player, shot, 0.0f, 0.0f, PLAYERSHOT_LOCK_ON, 70.0f);
+    } else {
+        Player_SetupTankShot(player, shot, PLAYERSHOT_LOCK_ON, 70.0f);
+    }
+    sCfShotTarget[shot - gPlayerShots] = target;
+}
+
+/* Fires one homing charged shot per locked target (or one plain one). Returns false if multi-lock is off. */
+bool CustomFox_FireMultiCharged(Player* player) {
+    Actor* targets[CF_MAX_MULTI_LOCK];
+    PlayerShot* shot;
+    s32 count;
+    s32 i;
+    s32 n = CustomFox_MultiLockCount();
+
+    if ((n == 0) || (player->num != 0)) {
+        return false;
+    }
+    /* locked targets first, then top up with whatever is in front right now */
+    CustomFox_MultiLockUpdate(player);
+    CustomFox_RememberLocks();
+    count = sCfLockedCount;
+    for (i = 0; i < count; i++) {
+        targets[i] = sCfLocked[i];
+    }
+    sCfLockedCount = 0;
+
+    if (count == 0) {
+        shot = CustomFox_FreeShot();
+        if (shot != NULL) {
+            CustomFox_SetupChargedShot(player, shot, NULL);
+        }
+    } else {
+        for (i = 0; i < count; i++) {
+            shot = CustomFox_FreeShot();
+            if (shot == NULL) {
+                break;
+            }
+            CustomFox_SetupChargedShot(player, shot, targets[i]);
+        }
+    }
+    Object_PlayerSfx(player->sfxSource, NA_SE_LOCK_ON_LASER, player->num);
+    gControllerRumbleTimers[player->num] = 5;
+    return true;
+}
+
+/* Homing: a multi-lock shot flies to its own target. Returns true and the aim point if it has one. */
+bool CustomFox_ShotHoming(PlayerShot* shot, Vec3f* aim) {
+    Actor* target = sCfShotTarget[shot - gPlayerShots];
+
+    if ((target == NULL) || (target->obj.status != OBJ_ACTIVE)) {
+        return false;
+    }
+    target->lockOnTimers[shot->sourceId] = 2;
+    aim->x = target->obj.pos.x;
+    aim->y = target->obj.pos.y + target->info.targetOffset;
+    aim->z = target->obj.pos.z;
+    return true;
+}
+
+/* ----------------------------------------------------------------------
+ * Homing lasers: with Rapid Fire Auto Charge or a Multi Lock cheat on, normal lasers
+ * fly at the enemies that are (or were just) locked on, taking turns between them.
+ * ---------------------------------------------------------------------- */
+
+bool CustomFox_LaserHomingOn(void) {
+    return !gVersusMode && (CF_ON(CF_RAPID_AUTO) || CF_ON(CF_MULTI_LOCK_3) || CF_ON(CF_MULTI_LOCK_5) ||
+                            CF_ON(CF_MULTI_LOCK_7) || CF_ON(CF_MULTI_LOCK_12));
+}
+
+static void CustomFox_LaserMemAdd(Actor* actor) {
+    s32 i;
+
+    for (i = 0; i < sCfLaserMemCount; i++) {
+        if (sCfLaserMem[i] == actor) {
+            return;
+        }
+    }
+    if (sCfLaserMemCount < CF_MAX_MULTI_LOCK) {
+        sCfLaserMem[sCfLaserMemCount++] = actor;
+    }
+}
+
+/* Called right before a charged shot goes out: its targets stay laser targets until destroyed. */
+void CustomFox_RememberLocks(void) {
+    s32 i;
+
+    if (!CustomFox_LaserHomingOn()) {
+        return;
+    }
+    sCfLaserMemCount = 0;
+    for (i = 0; i < sCfLockedCount; i++) {
+        CustomFox_LaserMemAdd(sCfLocked[i]);
+    }
+    for (i = 0; i < ARRAY_COUNT(gActors); i++) {
+        if ((gActors[i].obj.status == OBJ_ACTIVE) && (gActors[i].lockOnTimers[0] != 0)) {
+            CustomFox_LaserMemAdd(&gActors[i]);
+        }
+    }
+}
+
+static bool CustomFox_InFront(Player* player, Actor* actor) {
+    Vec3f fwd;
+    Vec3f up;
+    f32 along;
+
+    CustomFox_ShipBasis(player, &fwd, &up);
+    along = (actor->obj.pos.x - player->pos.x) * fwd.x +
+            (actor->obj.pos.y + actor->info.targetOffset - player->pos.y) * fwd.y +
+            (actor->obj.pos.z - player->trueZpos) * fwd.z;
+    return (along > 100.0f) && (along < 12000.0f);
+}
+
+static Actor* CustomFox_NextLaserTarget(void) {
+    Actor* list[ARRAY_COUNT(gActors)];
+    s32 n = 0;
+    s32 i;
+    s32 k;
+    Actor* actor;
+
+    for (i = 0, k = 0; i < sCfLaserMemCount; i++) { /* forget destroyed targets */
+        if (sCfLaserMem[i]->obj.status == OBJ_ACTIVE) {
+            sCfLaserMem[k++] = sCfLaserMem[i];
+        }
+    }
+    sCfLaserMemCount = k;
+
+    for (i = 0, actor = &gActors[0]; i < ARRAY_COUNT(gActors); i++, actor++) {
+        if ((actor->obj.status == OBJ_ACTIVE) && (actor->lockOnTimers[0] != 0) && (actor->info.targetOffset != 0.0f) &&
+            !CustomFox_IsAlly(actor) && CustomFox_InFront(&gPlayer[0], actor)) {
+            list[n++] = actor;
+        }
+    }
+    for (i = 0; i < sCfLaserMemCount; i++) {
+        actor = sCfLaserMem[i];
+        if (actor->lockOnTimers[0] == 0 && CustomFox_InFront(&gPlayer[0], actor)) {
+            list[n++] = actor;
+        }
+    }
+    if (n == 0) {
+        return NULL;
+    }
+    sCfLaserTurn++;
+    return list[sCfLaserTurn % n];
+}
+
+/* Called every frame for each laser (fox_beam.c). */
+void CustomFox_LaserHoming(PlayerShot* shot) {
+    s32 idx = shot - gPlayerShots;
+    Actor* target;
+    Vec3f want;
+    f32 speed;
+    f32 len;
+
+    if ((shot->sourceId != 0) || (idx < 0) || (idx >= ARRAY_COUNT(sCfShotTarget)) ||
+        ((shot->obj.id != PLAYERSHOT_SINGLE_LASER) && (shot->obj.id != PLAYERSHOT_TWIN_LASER)) ||
+        !CustomFox_LaserHomingOn() || (gPlayer[0].form != FORM_ARWING)) {
+        return;
+    }
+    target = sCfShotTarget[idx];
+    if ((target == NULL) && (shot->timer >= 33)) { /* a fresh laser picks its target */
+        target = CustomFox_NextLaserTarget();
+        sCfShotTarget[idx] = target;
+    }
+    if ((target == NULL) || (target->obj.status != OBJ_ACTIVE)) {
+        return;
+    }
+    want.x = target->obj.pos.x - shot->obj.pos.x;
+    want.y = target->obj.pos.y + target->info.targetOffset - shot->obj.pos.y;
+    want.z = target->obj.pos.z - shot->obj.pos.z;
+    len = sqrtf(SQ(want.x) + SQ(want.y) + SQ(want.z));
+    speed = sqrtf(SQ(shot->vel.x) + SQ(shot->vel.y) + SQ(shot->vel.z));
+    if ((len < 1.0f) || (speed < 1.0f)) {
+        return;
+    }
+    shot->vel.x += (want.x / len * speed - shot->vel.x) * 0.6f;
+    shot->vel.y += (want.y / len * speed - shot->vel.y) * 0.6f;
+    shot->vel.z += (want.z / len * speed - shot->vel.z) * 0.6f;
+    len = sqrtf(SQ(shot->vel.x) + SQ(shot->vel.y) + SQ(shot->vel.z));
+    shot->vel.x *= speed / len;
+    shot->vel.y *= speed / len;
+    shot->vel.z *= speed / len;
+    shot->obj.rot.y = Math_RadToDeg(Math_Atan2F(shot->vel.x, shot->vel.z)) - 180.0f;
+    shot->obj.rot.x = Math_RadToDeg(Math_Atan2F(shot->vel.y, sqrtf(SQ(shot->vel.x) + SQ(shot->vel.z))));
+}
+
+void CustomFox_SetShotTarget(PlayerShot* shot, Actor* target) {
+    s32 i = shot - gPlayerShots;
+
+    if ((i >= 0) && (i < ARRAY_COUNT(sCfShotTarget))) {
+        sCfShotTarget[i] = target;
+    }
+}
