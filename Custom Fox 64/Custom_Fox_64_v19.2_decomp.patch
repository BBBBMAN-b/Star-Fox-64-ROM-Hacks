+/*
+ * Custom Fox 64 - Ship Swap.
+ * #included at the bottom of src/engine/fox_play.c (main segment).
+ *
+ * The other ships' models live in asset bundles that only some levels load
+ * (ast_star_wolf = segment F, ast_allies = segment D, ast_great_fox = segment E).
+ * They are copied once into Expansion Pak RAM. Levels that leave those segments
+ * empty get them pointed at the copies; otherwise they are swapped in only while
+ * the player's ship is drawn. The Arwing MK2 uses a recolored copy of ast_arwing
+ * (segment 3) the same way.
+ */
+
+#include "sf64dma.h"
+#include "assets/ast_star_wolf.h"
+#include "assets/ast_allies.h"
+#include "assets/ast_great_fox.h"
+#include "assets/ast_arwing.h"
+#include "customfox_lasertex.inc.c"
+
+#define CF_EXP_STAR_WOLF 0x80400000
+#define CF_EXP_ALLIES 0x80420000
+#define CF_EXP_GREAT_FOX 0x80440000
+#define CF_EXP_ARWING_MK2 0x80460000
+
+#define CF_SHIELD_RECHARGE_FRAMES (5 * 30) /* game runs at 30 fps */
+#define CF_BILL_BOMB_FRAMES (10 * 30) /* Bill's Fighter MK2 */
+#define CF_KATT_ROLL_HEAL_PCT 5      /* Katt's Fighter MK2: health back per barrel roll */
+#define CF_MK2_BOMB_FRAMES (8 * 30)
+#define CF_MAX_MULTI_LOCK 12
+
+void Load_RomFile(void* vRomAddress, void* dest, ptrdiff_t size);
+
+u8 gCustomFoxShip = CFSHIP_ARWING;
+bool gCustomFoxShipAssetsLoaded = false;
+
+static s32 sCfShieldHits = 0;
+static s32 sCfShieldTimer = 0;
+/* Andross's Revenge green shield: sits on top of any ship shield, 10 second recharge */
+#define CF_GREEN_SHIELDS 3
+#define CF_GREEN_RECHARGE_FRAMES (30 * 10)
+static s32 sCfGreenHits = 0;
+static s32 sCfGreenTimer = 0;
+s32 gCfGreenShieldFx = 0;
+static s32 sCfBombTimer = 0;
+static s32 sCfPrevRoll = 0;
+static s32 sCfMk2Laser = LASERS_SINGLE; /* MK2 never loses laser upgrades during a run */
+static Actor* sCfShotTarget[16];        /* per-shot homing target for multi-lock charged shots */
+static Actor* sCfLocked[12];            /* targets held for the current charge (CF_MAX_MULTI_LOCK) */
+static s32 sCfLockedCount = 0;
+static Actor* sCfLaserMem[CF_MAX_MULTI_LOCK];
+static s32 sCfLaserMemCount = 0;
+static s32 sCfLaserTurn = 0;
+
+/* ----------------------------------------------------------------------
+ * Laser colors
+ * ---------------------------------------------------------------------- */
+
+#define CF_LASER_DL(name, tex)                                                                               \
+    Gfx name[] = {                                                                                           \
+        gsDPLoadTextureBlock(tex, G_IM_FMT_RGBA, G_IM_SIZ_16b, 8, 8, 0, G_TX_NOMIRROR | G_TX_CLAMP,          \
+                             G_TX_NOMIRROR | G_TX_CLAMP, 3, 3, G_TX_NOLOD, G_TX_NOLOD),                      \
+        gsSPVertex(ast_common_seg1_vtx_1AD88, 12, 0),                                                        \
+        gsSP2Triangles(0, 1, 2, 0, 3, 4, 2, 0),                                                              \
+        gsSP2Triangles(5, 3, 2, 0, 1, 6, 2, 0),                                                              \
+        gsSP2Triangles(7, 8, 9, 0, 8, 10, 9, 0),                                                             \
+        gsSP2Triangles(10, 11, 9, 0, 11, 7, 9, 0),                                                           \
+        gsSPEndDisplayList(),                                                                                \
+    }
+
+CF_LASER_DL(aCfLaserPurpleDL, aCfLaserPurpleTex);
+CF_LASER_DL(aCfLaserYellowDL, aCfLaserYellowTex);
+CF_LASER_DL(aCfLaserOrangeDL, aCfLaserOrangeTex);
+CF_LASER_DL(aCfLaserRedDL, aCfLaserRedTex);
+CF_LASER_DL(aCfLaserGoldDL, aCfLaserGoldTex);
+
+typedef enum CustomFoxLaserColor {
+    CFLC_DEFAULT,
+    CFLC_GREEN,
+    CFLC_BLUE,
+    CFLC_PURPLE,
+    CFLC_YELLOW,
+    CFLC_ORANGE,
+    CFLC_RED,
+    CFLC_GOLD
+} CustomFoxLaserColor;
+
+/* ----------------------------------------------------------------------
+ * Ship info
+ * ---------------------------------------------------------------------- */
+
+/* The ship actually in use: falls back to the Arwing without an Expansion Pak or in Versus. */
+s32 CustomFox_ActiveShip(void) {
+    if (gVersusMode || !gCustomFoxShipAssetsLoaded || (gCustomFoxShip >= CFSHIP_SELECTABLE)) {
+        return CFSHIP_ARWING;
+    }
+    return gCustomFoxShip;
+}
+
+static s32 CustomFox_ShieldMax(void) {
+    switch (CustomFox_ActiveShip()) {
+        case CFSHIP_WOLFEN_II:
+            return 2;
+        case CFSHIP_ARWING_MK2:
+            return 3;
+        case CFSHIP_GREAT_FOX:
+            return 12;
+        default:
+            return 0;
+    }
+}
+
+/* Only the standard Arwing can have its wings broken off. */
+bool CustomFox_ShipHasWings(void) {
+    return CustomFox_ActiveShip() == CFSHIP_ARWING;
+}
+
+/* Max health. MK2 and Great Fox have double, and 3 gold rings add another third. */
+s32 CustomFox_MaxShields(bool goldRings) {
+    s32 ship = CustomFox_ActiveShip();
+
+    if ((ship == CFSHIP_ARWING_MK2) || (ship == CFSHIP_GREAT_FOX)) {
+        return goldRings ? 680 : 510;
+    }
+    return goldRings ? 383 : 255;
+}
+
+f32 CustomFox_ShieldGaugeScale(bool goldRings) {
+    return (CustomFox_MaxShields(goldRings) + 1) / 256.0f;
+}
+
+static s32 CustomFox_LaserColor(void) {
+    switch (CustomFox_ActiveShip()) {
+        case CFSHIP_WOLFEN:
+            return CFLC_RED;
+        case CFSHIP_WOLFEN_II:
+            switch (gLaserStrength[0]) {
+                case LASERS_SINGLE:
+                    return CFLC_GREEN;
+                case LASERS_TWIN:
+                    return CFLC_ORANGE;
+                default:
+                    return CFLC_RED;
+            }
+        case CFSHIP_KATT_MK2:
+            return CFLC_PURPLE;
+        case CFSHIP_GREAT_FOX:
+            return CFLC_YELLOW;
+        case CFSHIP_BILL_MK2: /* standard progression, but the hyper lasers are yellow */
+            return (gLaserStrength[0] >= LASERS_HYPER) ? CFLC_YELLOW : CFLC_DEFAULT;
+        case CFSHIP_ARWING_MK2:
+            switch (gLaserStrength[0]) {
+                case LASERS_SINGLE:
+                    return CFLC_GREEN;
+                case LASERS_TWIN:
+                    return CFLC_BLUE;
+                default:
+                    return CFLC_GOLD;
+            }
+        default:
+            return CFLC_DEFAULT;
+    }
+}
+
+Gfx* CustomFox_LaserDL(PlayerShot* shot, Gfx* defaultDL) {
+    if (shot->sourceId != 0) {
+        return defaultDL;
+    }
+    switch (CustomFox_LaserColor()) {
+        case CFLC_GREEN:
+            return aLaserShotGreenDL;
+        case CFLC_BLUE:
+            return aLaserShotBlueDL;
+        case CFLC_PURPLE:
+            return aCfLaserPurpleDL;
+        case CFLC_YELLOW:
+            return aCfLaserYellowDL;
+        case CFLC_ORANGE:
+            return aCfLaserOrangeDL;
+        case CFLC_RED:
+            return aCfLaserRedDL;
+        case CFLC_GOLD:
+            return aCfLaserGoldDL;
+        default:
+            return defaultDL;
+    }
+}
+
+/* Ships that fire twin lasers even before any laser upgrade. */
+bool CustomFox_ForceTwinLaser(void) {
+    s32 ship = CustomFox_ActiveShip();
+
+    return (ship == CFSHIP_WOLFEN_II) || (ship == CFSHIP_ARWING_MK2);
+}
+
+/* Glow color of the charged shot. */
+void CustomFox_ChargeColor(PlayerShot* shot, s32* r, s32* g, s32* b) {
+    *r = 0;
+    *g = 255;
+    *b = 0;
+    if (shot->sourceId != 0) {
+        return;
+    }
+    switch (CustomFox_LaserColor()) {
+        case CFLC_PURPLE:
+            *r = 190;
+            *g = 50;
+            *b = 255;
+            break;
+        case CFLC_RED:
+            *r = 255;
+            *g = 30;
+            *b = 30;
+            break;
+        case CFLC_BLUE:
+            *r = 40;
+            *g = 120;
+            *b = 255;
+            break;
+        case CFLC_GOLD:
+            *r = 255;
+            *g = 190;
+            *b = 30;
+            break;
+        case CFLC_ORANGE:
+            *r = 255;
+            *g = 120;
+            *b = 0;
+            break;
+    }
+}
+
+/* ----------------------------------------------------------------------
+ * Loading the models
+ * ---------------------------------------------------------------------- */
+
+/* One RGBA16 pixel: blue becomes gold, white/cream/grey becomes dark grey. */
+static u16 CustomFox_Mk2Pixel(u16 px) {
+    s32 r = (px >> 11) & 31;
+    s32 g = (px >> 6) & 31;
+    s32 b = (px >> 1) & 31;
+    s32 mx = MAX(r, MAX(g, b));
+    s32 mn = MIN(r, MIN(g, b));
+    s32 v;
+
+    if ((b > r + 3) && (b > g + 1)) {
+        r = mx;
+        g = (24 * mx) / 31;
+        b = (5 * mx) / 31;
+    } else if (((mx - mn) <= 7) && (mx > 8)) {
+        v = 2 + (mx * 4) / 31; /* dark grey so the gold pops */
+        r = v;
+        g = v;
+        b = v + 1;
+    }
+    return (r << 11) | (g << 6) | (b << 1) | (px & 1);
+}
+
+static void CustomFox_RecolorTex(u16* segTex, s32 count) {
+    u16* tex = (u16*) (CF_EXP_ARWING_MK2 + ((uintptr_t) segTex & 0xFFFFFF));
+    s32 i;
+
+    for (i = 0; i < count; i++) {
+        tex[i] = CustomFox_Mk2Pixel(tex[i]);
+    }
+}
+
+static void CustomFox_BuildMk2(void) {
+    Load_RomFile(SEGMENT_ROM_START(ast_arwing), (void*) CF_EXP_ARWING_MK2, SEGMENT_ROM_SIZE(ast_arwing));
+    CustomFox_RecolorTex(aAwArwingTex1, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex2, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex3, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex4, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex5, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex6, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex7, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex8, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex9, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex10, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex11, 64 * 32);
+    CustomFox_RecolorTex(aAwArwingTex12, 64 * 32);
+    CustomFox_RecolorTex(aAwArwingTex13, 32 * 32);
+    CustomFox_RecolorTex(aAwArwingTex14, 32 * 32);
+    osWritebackDCacheAll(); /* the RDP reads textures straight from RAM */
+}
+
+static void CustomFox_LoadOmegaAssets(void); /* customfox_omega.inc.c */
+
+/* Called from Load_SceneFiles. Runs once, behind a loading screen. */
+void CustomFox_LoadShipAssets(void) {
+    if (gCustomFoxShipAssetsLoaded || (osMemSize < 0x800000)) {
+        return;
+    }
+    Load_RomFile(SEGMENT_ROM_START(ast_star_wolf), (void*) CF_EXP_STAR_WOLF, SEGMENT_ROM_SIZE(ast_star_wolf));
+    Load_RomFile(SEGMENT_ROM_START(ast_allies), (void*) CF_EXP_ALLIES, SEGMENT_ROM_SIZE(ast_allies));
+    Load_RomFile(SEGMENT_ROM_START(ast_great_fox), (void*) CF_EXP_GREAT_FOX, SEGMENT_ROM_SIZE(ast_great_fox));
+    CustomFox_BuildMk2();
+    CustomFox_LoadOmegaAssets();
+    gCustomFoxShipAssetsLoaded = true;
+}
+
+/* Arwing skeleton drawn with the recolored MK2 textures (segment 3 swapped in). */
+static void CustomFox_DrawMk2(ArwingInfo* arwing) {
+    u32 saved = gSegments[3];
+
+    gSegments[3] = K0_TO_PHYS(CF_EXP_ARWING_MK2); /* CPU-side reads (animations) */
+    gSPSegment(gMasterDisp++, 0x03, gSegments[3]);
+    Display_Arwing_Skel(arwing);
+    gSegments[3] = saved;
+    gSPSegment(gMasterDisp++, 0x03, saved);
+}
+
+/* Draws a ship model at the current matrix. Caller sets up the matrix and render mode. */
+void CustomFox_DrawShipModel(s32 ship) {
+    Gfx* dl;
+
+    if (!gCustomFoxShipAssetsLoaded) {
+        return;
+    }
+    switch (ship) {
+        case CFSHIP_WOLFEN:
+            dl = aStarWolfStandardShipDL;
+            break;
+        case CFSHIP_WOLFEN_II:
+            dl = aStarWolfUpgradedShipDL;
+            break;
+        case CFSHIP_KATT:
+        case CFSHIP_KATT_MK2:
+            dl = aKattShipDL;
+            break;
+        case CFSHIP_BILL:
+        case CFSHIP_BILL_MK2:
+            dl = aBillShipDL;
+            break;
+        case CFSHIP_GREAT_FOX:
+            dl = aGreatFoxIntactDL;
+            break;
+        case CFSHIP_ARWING_MK2: {
+            /* menu preview: gPlayer only exists during levels, so use a local Arwing state */
+            static ArwingInfo sPreviewArwing;
+
+            sPreviewArwing.rightWingState = sPreviewArwing.leftWingState = WINGSTATE_INTACT;
+            sPreviewArwing.drawFace = 0;
+            CustomFox_DrawMk2(&sPreviewArwing);
+            return;
+        }
+        default:
+            return;
+    }
+
+    gSPSegment(gMasterDisp++, 0x0D, K0_TO_PHYS(CF_EXP_ALLIES));
+    gSPSegment(gMasterDisp++, 0x0E, K0_TO_PHYS(CF_EXP_GREAT_FOX));
+    gSPSegment(gMasterDisp++, 0x0F, K0_TO_PHYS(CF_EXP_STAR_WOLF));
+    gSPDisplayList(gMasterDisp++, dl);
+    gSPSegment(gMasterDisp++, 0x0D, gSegments[0x0D]);
+    gSPSegment(gMasterDisp++, 0x0E, gSegments[0x0E]);
+    gSPSegment(gMasterDisp++, 0x0F, gSegments[0x0F]);
+}
+
+/* Replaces the Arwing body during gameplay. Returns true if it drew the ship. */
+bool CustomFox_DrawPlayerShip(Player* player) {
+    s32 ship = CustomFox_ActiveShip();
+
+    if ((ship == CFSHIP_ARWING) || (gGameState != GSTATE_PLAY) || (player->num != 0)) {
+        return false;
+    }
+    if (ship == CFSHIP_ARWING_MK2) {
+        CustomFox_DrawMk2(&player->arwing);
+    } else if (ship == CFSHIP_GREAT_FOX) {
+        Matrix_Push(&gGfxMatrix);
+        Matrix_Scale(gGfxMatrix, 0.12f, 0.12f, 0.12f, MTXF_APPLY);
+        Matrix_SetGfxMtx(&gMasterDisp);
+        CustomFox_DrawShipModel(ship);
+        Matrix_Pop(&gGfxMatrix);
+        Matrix_SetGfxMtx(&gMasterDisp);
+    } else {
+        CustomFox_DrawShipModel(ship);
+        if (ship == CFSHIP_WOLFEN_II) { /* the Venom 2 look: twin green engines */
+            f32 glow = ((gGameFrameCount % 2) != 0) ? (0.38f * 1.2f) : 0.38f;
+            s32 side;
+
+            for (side = -1; side <= 1; side += 2) {
+                Matrix_Push(&gGfxMatrix);
+                Matrix_Translate(gGfxMatrix, 30.0f * side, 0.0f, -60.0f, MTXF_APPLY);
+                Matrix_Scale(gGfxMatrix, glow, glow, glow, MTXF_APPLY);
+                Matrix_SetGfxMtx(&gMasterDisp);
+                Display_DrawEngineGlow(EG_GREEN);
+                Matrix_Pop(&gGfxMatrix);
+            }
+            Matrix_SetGfxMtx(&gMasterDisp);
+        }
+    }
+    return true;
+}
+
+/* ----------------------------------------------------------------------
+ * Damage, shields and abilities
+ * ---------------------------------------------------------------------- */
+
+/* Called from Player_ApplyDamage with the damage about to hit the shields bar. */
+s32 CustomFox_ShipTakeDamage(Player* player, s32 damage) {
+    if ((player->num != 0) || (damage <= 0)) {
+        return damage;
+    }
+    if (CustomFox_ShieldMax() > 0) {
+        sCfShieldTimer = 0; /* the recharge countdown restarts on every hit */
+    }
+    sCfGreenTimer = 0;
+    if (CustomFox_ActiveShip() == CFSHIP_BILL_MK2) {
+        damage = (damage + 1) / 2; /* upgraded armor: half damage */
+    }
+    return damage;
+}
+
+/*
+ * Called at the top of Player_ApplyDamage. If the ship's shield has charge left,
+ * the hit is fully blocked: shield bubble + sound, no knockback or red flash.
+ */
+bool CustomFox_ShieldAbsorb(Player* player, s32 damage) {
+    if ((player->num == 0) && (damage > 0) && CustomFox_IsRevenge() && (sCfGreenHits > 0)) {
+        sCfGreenHits--;
+        sCfGreenTimer = 0;
+        sCfShieldTimer = 0;
+        gCfGreenShieldFx = 20;
+        gShieldTimer[0] = 5;
+        gShieldAlpha[0] = 2.0f;
+        player->mercyTimer = 10;
+        Player_PlaySfx(player->sfxSource, NA_SE_DAMAGE_S, player->num);
+        AUDIO_PLAY_SFX(NA_SE_SHIELD_RING, gDefaultSfxSource, 4);
+        return true;
+    }
+    if ((player->num != 0) || (damage <= 0) || (CustomFox_ShieldMax() == 0) || (sCfShieldHits <= 0)) {
+        return false;
+    }
+    gCfGreenShieldFx = 0;
+    sCfShieldHits--;
+    sCfShieldTimer = 0;
+    sCfGreenTimer = 0;
+    gShieldTimer[0] = 5;
+    gShieldAlpha[0] = 2.0f; /* shows the shield bubble */
+    player->mercyTimer = 10; /* stop one long collision draining every pip at once */
+    Player_PlaySfx(player->sfxSource, NA_SE_DAMAGE_S, player->num);
+    AUDIO_PLAY_SFX(NA_SE_SHIELD_RING, gDefaultSfxSource, 4);
+    return true;
+}
+
+s32 CustomFox_ShipLaserDamage(s32 damage, PlayerShot* shot) {
+    s32 ship = CustomFox_ActiveShip();
+
+    if ((shot->sourceId != 0) ||
+        !((shot->obj.id == PLAYERSHOT_SINGLE_LASER) || (shot->obj.id == PLAYERSHOT_TWIN_LASER))) {
+        return damage;
+    }
+    if (ship == CFSHIP_KATT_MK2) {
+        return damage * 2;
+    }
+    if ((ship == CFSHIP_ARWING_MK2) && (gLaserStrength[0] >= LASERS_HYPER)) {
+        return damage * 2; /* gold lasers */
+    }
+    return damage;
+}
+
+/* Bombs and (for the MK2) charged-shot blasts. */
+f32 CustomFox_ShipBlastScale(PlayerShot* shot) {
+    if ((shot->sourceId == 0) && (shot->obj.id == PLAYERSHOT_LOCK_ON) &&
+        (CustomFox_ActiveShip() == CFSHIP_ARWING_MK2)) {
+        return 2.0f;
+    }
+    return 1.0f;
+}
+
+/* Called when a brand new game starts (not on every level). */
+void CustomFox_NewGame(void) {
+    sCfMk2Laser = LASERS_SINGLE;
+}
+
+/* Per-frame ship abilities (called from CustomFox_PlayUpdate). */
+static void CustomFox_ShipUpdate(void) {
+    Player* player = &gPlayer[0];
+    s32 ship = CustomFox_ActiveShip();
+    s32 max = CustomFox_ShieldMax();
+    s32 bombFrames = 0;
+
+    switch (ship) {
+        case CFSHIP_KATT_MK2:
+        case CFSHIP_GREAT_FOX:
+            gLaserStrength[0] = LASERS_HYPER;
+            break;
+        case CFSHIP_WOLFEN:
+            gLaserStrength[0] = LASERS_SINGLE;
+            break;
+        case CFSHIP_ARWING_MK2:
+            if (gLaserStrength[0] < sCfMk2Laser) {
+                gLaserStrength[0] = sCfMk2Laser;
+            } else {
+                sCfMk2Laser = gLaserStrength[0];
+            }
+            bombFrames = CF_MK2_BOMB_FRAMES;
+            break;
+        case CFSHIP_BILL_MK2:
+            bombFrames = CF_BILL_BOMB_FRAMES;
+            break;
+    }
+
+    if (player->state != PLAYERSTATE_ACTIVE) {
+        return;
+    }
+
+    if ((max > 0) && (sCfShieldHits < max)) {
+        sCfShieldTimer++;
+        if (sCfShieldTimer >= CF_SHIELD_RECHARGE_FRAMES) {
+            sCfShieldTimer = 0;
+            sCfShieldHits = max;
+            AUDIO_PLAY_SFX(NA_SE_SHIELD_UPGRADE, gDefaultSfxSource, 4);
+        }
+    }
+
+    if (gCfGreenShieldFx > 0) {
+        gCfGreenShieldFx--;
+    }
+    if (CustomFox_IsRevenge() && (sCfGreenHits < CF_GREEN_SHIELDS)) {
+        sCfGreenTimer++;
+        if (sCfGreenTimer >= CF_GREEN_RECHARGE_FRAMES) {
+            sCfGreenTimer = 0;
+            sCfGreenHits = CF_GREEN_SHIELDS;
+            AUDIO_PLAY_SFX(NA_SE_SHIELD_UPGRADE, gDefaultSfxSource, 4);
+        }
+    }
+
+    /* Katt's Fighter MK2: every barrel roll restores 5% health */
+    if ((ship == CFSHIP_KATT_MK2) && (player->rollState != 0) && (sCfPrevRoll == 0)) {
+        s32 full = Play_GetMaxShields();
+
+        if (player->shields < full) {
+            player->shields += (full * CF_KATT_ROLL_HEAL_PCT + 99) / 100;
+            if (player->shields > full) {
+                player->shields = full;
+            }
+            AUDIO_PLAY_SFX(NA_SE_SHIELD_RING, gDefaultSfxSource, 4);
+        }
+    }
+    sCfPrevRoll = player->rollState;
+
+    if (bombFrames > 0) {
+        sCfBombTimer++;
+        if (sCfBombTimer >= bombFrames) {
+            sCfBombTimer = 0;
+            if (gBombCount[0] < 9) {
+                gBombCount[0]++;
+                AUDIO_PLAY_SFX(NA_SE_BOMB_GET, gDefaultSfxSource, 4);
+            }
+        }
+    }
+}
+
