+static void CustomFoxMenu_DrawShipPreview(s32 ship) {
+    f32 dirX;
+    f32 dirY;
+    f32 dirZ;
+
+    Option_SetMenuLightPos(-60.0f, 30.0f, 100.0f, &dirX, &dirY, &dirZ);
+    Lights_SetOneLight(&gMasterDisp, dirX, dirY, dirZ, 225, 225, 225, 50, 50, 50);
+
+    Option_Menu_Push();
+    Matrix_Translate(gGfxMatrix, 36.0f, 2.0f, -130.0f, MTXF_APPLY);
+    Matrix_RotateX(gGfxMatrix, M_DTOR * 20.0f, MTXF_APPLY);
+    Matrix_RotateY(gGfxMatrix, M_DTOR * sCfPreviewRot, MTXF_APPLY);
+
+    if ((ship == CFSHIP_ARWING) || (CF_MK2_PREVIEW_SIMPLE && (ship == CFSHIP_ARWING_MK2))) {
+        Matrix_Scale(gGfxMatrix, 0.18f, 0.18f, 0.18f, MTXF_APPLY);
+        Matrix_SetGfxMtx(&gMasterDisp);
+        RCP_SetupDL_55();
+        gSPDisplayList(gMasterDisp++, aMapArwingDL);
+    } else {
+        if (ship == CFSHIP_GREAT_FOX) {
+            Matrix_Scale(gGfxMatrix, 0.014f, 0.014f, 0.014f, MTXF_APPLY);
+            Matrix_RotateY(gGfxMatrix, M_PI, MTXF_APPLY);
+        } else if (ship == CFSHIP_ARWING_MK2) {
+            Matrix_Scale(gGfxMatrix, 0.2f, 0.2f, 0.2f, MTXF_APPLY);
+        } else {
+            Matrix_Scale(gGfxMatrix, 0.2f, 0.2f, 0.2f, MTXF_APPLY);
+        }
+        Matrix_SetGfxMtx(&gMasterDisp);
+        RCP_SetupDL_23();
+        CustomFox_DrawShipModel(ship);
+    }
+    Matrix_Pop(&gGfxMatrix);
+}
