diff --git a/src/mods/customfox_modes.inc.c b/src/mods/customfox_modes.inc.c
new file mode 100644
index 0000000..0178e45
--- /dev/null
+++ b/src/mods/customfox_modes.inc.c
@@ -0,0 +1,996 @@
+/*
+ * Custom Fox 64 - difficulty modes (Misc page).
+ * #included from src/engine/fox_play.c, after customfox_ships.inc.c.
+ *
+ * HARD:
+ *   - enemies do 2x damage to the player (same as Expert)
+ *   - Falco, Slippy and Peppy can be hit but are never shot down
+ *   - allies fire level 3 twin lasers (Katt: purple 2x, Bill: blue hyper)
+ *   - bosses have double health; the first half is shown as a turquoise SHIELD bar
+ *
+ * ANDROSS'S REVENGE (everything from HARD, plus):
+ *   - 4x damage to the player
+ *   - bosses 5x health (4 shields); Andross 5x, or 10x on the hard route, with no bar
+ *   - barrel rolls make the player invincible (shields are not used up either)
+ *   - an extra green shield that recharges every 10 seconds (see customfox_ships.inc.c)
+ *
+ * MORE ENEMIES (separate toggle): see CustomFox_MoreEnemies* below.
+ *
+ * The boss health multiplier works by scaling what the boss code subtracts from its
+ * own HP counters (CF_BOSS_DMG at each boss HP site), so the damage values bosses
+ * test against (e.g. Aquas' charged-shot check) stay untouched.
+ */
+
+u8 gCustomFoxMisc[CFMISC_MAX];
+u8 gCustomFoxDifficulty = CFDIFF_NONE;
+
+static s32 sCfBossDmgCarry = 0;
+static s32 sCfLastLevel = -1;
+static bool sCfAndrossHardRoute = false;
+
+#define CF_ALLY_SHIELD_FLOOR 32
+
+bool CustomFox_IsHard(void) {
+    return !gVersusMode && (gCustomFoxDifficulty != CFDIFF_NONE);
+}
+
+bool CustomFox_IsRevenge(void) {
+    return !gVersusMode && (gCustomFoxDifficulty == CFDIFF_ANDROSS_REVENGE);
+}
+
+/* Shorter boss attack cooldowns: Hard attacks 1.5x as often, Andross's Revenge 2x. */
+s32 CustomFox_BossRate(s32 frames) {
+    if (frames <= 1) {
+        return frames;
+    }
+    if (CustomFox_IsRevenge()) {
+        return (frames + 1) / 2;
+    }
+    if (CustomFox_IsHard()) {
+        return (frames * 2 + 2) / 3;
+    }
+    return frames;
+}
+
+s32 CustomFox_BossStep(void) {
+    if (CustomFox_IsRevenge()) {
+        return 2;
+    }
+    if (CustomFox_IsHard()) {
+        return (gGameFrameCount & 1) + 1;
+    }
+    return 1;
+}
+
+/* Andross's Revenge: no damage at all while the barrel roll animation is playing. */
+bool CustomFox_RollInvincible(Player* player) {
+    return CustomFox_IsRevenge() && (player->num == 0) && (player->rollState != 0);
+}
+
+s32 CustomFox_BossHealthMult(void) {
+    if (gVersusMode) {
+        return 1;
+    }
+    switch (gCustomFoxDifficulty) {
+        case CFDIFF_HARD:
+            return 2;
+        case CFDIFF_ANDROSS_REVENGE:
+            if ((gCurrentLevel == LEVEL_VENOM_ANDROSS) && sCfAndrossHardRoute) {
+                return 10;
+            }
+            return 5;
+        default:
+            return 1;
+    }
+}
+
+/* Damage actually removed from a boss HP counter. Keeps the remainder so the total is exact. */
+s32 CustomFox_BossDamage(s32 damage) {
+    s32 mult = CustomFox_BossHealthMult();
+    s32 out;
+
+    if ((mult <= 1) || (damage <= 0)) {
+        return damage;
+    }
+    sCfBossDmgCarry += damage;
+    out = sCfBossDmgCarry / mult;
+    sCfBossDmgCarry -= out * mult;
+    return out;
+}
+
+/*
+ * Splits the boss bar (0-255) into equal segments: the top ones are shields, the last is health.
+ * Returns how many shields are still up and writes the fill (0-255) of the current segment.
+ */
+s32 CustomFox_BossBarSegment(s32 bar, s32* segBar) {
+    s32 mult = CustomFox_BossHealthMult();
+    f32 size;
+    s32 seg;
+
+    if (bar > 255) {
+        bar = 255;
+    }
+    if ((mult <= 1) || (bar <= 0)) {
+        *segBar = bar;
+        return 0;
+    }
+    size = 255.0f / mult;
+    seg = (s32) ((bar - 1) / size);
+    if (seg > mult - 1) {
+        seg = mult - 1;
+    }
+    *segBar = (s32) (((bar - seg * size) / size) * 255.0f + 0.5f);
+    if (*segBar > 255) {
+        *segBar = 255;
+    }
+    return seg;
+}
+
+/* Andross's Revenge: Andross never shows a bar (the game has none for him anyway). */
+bool CustomFox_BossBarHidden(void) {
+    return !gVersusMode && (gCustomFoxDifficulty == CFDIFF_ANDROSS_REVENGE) && (gCurrentLevel == LEVEL_VENOM_ANDROSS);
+}
+
+/* Allies take hits but their shields never run out. Call right after a hit is subtracted. */
+void CustomFox_AllyClamp(s32* shields, s32 before) {
+    if (CustomFox_IsHard() && (before > 0) && (*shields < CF_ALLY_SHIELD_FLOOR)) {
+        *shields = CF_ALLY_SHIELD_FLOOR;
+    }
+}
+
+/* Same for an ally actor's 16-bit health (boss-fight teammates). */
+s16 CustomFox_AllyClampHealth(s16 health, s32 before) {
+    if (CustomFox_IsHard() && (before > 0) && (health < CF_ALLY_SHIELD_FLOOR)) {
+        return CF_ALLY_SHIELD_FLOOR;
+    }
+    return health;
+}
+
+/* Per-frame safety net for live allies. */
+void CustomFox_AllyFloor(void) {
+    s32 i;
+
+    if (!CustomFox_IsHard()) {
+        return;
+    }
+    for (i = TEAM_ID_FALCO; i <= TEAM_ID_PEPPY; i++) {
+        if ((gTeamShields[i] > 0) && (gTeamShields[i] < CF_ALLY_SHIELD_FLOOR)) {
+            gTeamShields[i] = CF_ALLY_SHIELD_FLOOR;
+        }
+        if (gTeamShields[i] > 0) {
+            gTeamDamage[i] = 0;
+        }
+    }
+}
+
+s32 CustomFox_EnemyDamage(s32 damage) {
+    if (CustomFox_IsRevenge()) {
+        return damage * 4;
+    }
+    if (CustomFox_IsHard()) {
+        return damage * 2;
+    }
+    return damage;
+}
+
+/* TEAM_ID_* of the ally that fired this shot, or -1. */
+s32 CustomFox_AllyLaserTeam(PlayerShot* shot) {
+    s32 id = shot->sourceId - NPC_SHOT_ID;
+
+    if ((shot->sourceId < NPC_SHOT_ID) || (id <= 0) || (id >= ARRAY_COUNT(gActors))) {
+        return -1;
+    }
+    if (gLevelMode == LEVELMODE_ALL_RANGE) {
+        switch (id) {
+            case AI360_FALCO:
+                return TEAM_ID_FALCO;
+            case AI360_SLIPPY:
+                return TEAM_ID_SLIPPY;
+            case AI360_PEPPY:
+                return TEAM_ID_PEPPY;
+            case AI360_KATT:
+                return TEAM_ID_KATT;
+            case AI360_BILL:
+                return TEAM_ID_BILL;
+            default:
+                return -1;
+        }
+    }
+    if ((gActors[id].obj.status == OBJ_ACTIVE) && (gActors[id].obj.id == OBJ_ACTOR_EVENT) &&
+        (gActors[id].iwork[EVA_TEAM_ID] >= TEAM_ID_FALCO) && (gActors[id].iwork[EVA_TEAM_ID] <= TEAM_ID_BILL)) {
+        return gActors[id].iwork[EVA_TEAM_ID];
+    }
+    return -1;
+}
+
+/* 0 = normal, 1 = level 3 blue twin lasers, 2 = Katt's purple double damage lasers */
+static s32 CustomFox_AllyLaserKind(PlayerShot* shot) {
+    s32 team;
+    bool upgradeKB = CustomFox_IsHard() || CF_ON(CF_KATT_BILL_SHIPS);
+    bool lasers = CustomFox_IsHard() || CF_ON(CF_ALLY_LASERS);
+
+    if (gVersusMode || (shot->obj.id != PLAYERSHOT_TWIN_LASER) || (!upgradeKB && !lasers)) {
+        return 0;
+    }
+    team = CustomFox_AllyLaserTeam(shot);
+    if (team < 0) {
+        return 0;
+    }
+    if ((team == TEAM_ID_KATT) && upgradeKB) {
+        return 2;
+    }
+    if (lasers || ((team == TEAM_ID_BILL) && upgradeKB)) {
+        return 1;
+    }
+    return 0;
+}
+
+s32 CustomFox_AllyLaserDamage(s32 damage, PlayerShot* shot) {
+    switch (CustomFox_AllyLaserKind(shot)) {
+        case 2:
+            return 30; /* Katt's fighter: purple hyper lasers at double damage */
+        case 1:
+            if (damage < 15) {
+                return 15; /* level 3 hyper laser */
+            }
+            return damage;
+        default:
+            return damage;
+    }
+}
+
+/* Laser model for an upgraded ally shot, or NULL to draw it normally. */
+Gfx* CustomFox_AllyLaserDL(PlayerShot* shot) {
+    switch (CustomFox_AllyLaserKind(shot)) {
+        case 2:
+            return aCfLaserPurpleDL;
+        case 1:
+            return aLaserShotBlueDL;
+        default:
+            return NULL;
+    }
+}
+
+/* Bill's fighter takes a third of the damage (Ship Swap ability) when he is upgraded. */
+s32 CustomFox_BillDamage(s32 damage) {
+    if ((CustomFox_IsHard() || CF_ON(CF_KATT_BILL_SHIPS)) && (damage > 0)) {
+        return (damage + 2) / 3;
+    }
+    return damage;
+}
+
+static void CustomFox_MoreEnemiesReset(void);
+
+static s32 sCfOutroTimer;
+
+static void CustomFox_ModesLevelStart(void) {
+    sCfBossDmgCarry = 0;
+    sCfOutroTimer = 0;
+    if (gCurrentLevel != sCfLastLevel) {
+        if (gCurrentLevel == LEVEL_VENOM_ANDROSS) {
+            if (sCfLastLevel == LEVEL_VENOM_2) {
+                sCfAndrossHardRoute = true;
+            } else if (sCfLastLevel == LEVEL_VENOM_1) {
+                sCfAndrossHardRoute = false;
+            }
+        }
+        sCfLastLevel = gCurrentLevel;
+    }
+    CustomFox_MoreEnemiesReset();
+}
+
+/* ----------------------------------------------------------------------
+ * MORE ENEMIES
+ *
+ * Every enemy that can be destroyed gets a twin:
+ *  - Scripted enemies: a snapshot is taken when they spawn; a moment later a copy starts
+ *    at the same spawn point on the same flight script, trailing behind the original.
+ *    If the original hasn't moved (turrets, ground units) the copy sits beside it instead.
+ *  - Level enemies with their own AI (Titania, Zoness, Aquas, Meteo, Corneria robots...):
+ *    a second one is loaded beside the first.
+ *  - All-range enemies (Fortuna, Katina, Bolse, Sector Z): each new enemy fighter gets a twin.
+ * Never copied: bosses, Star Wolf, missiles, allies, story actors, anything that can't
+ * be damaged, and the Macbeth train.
+ *
+ * Copies never play radio messages, damage or restore the team, change music or
+ * reverb, join kill-groups or take over formation leadership. They do drop items.
+ * The copies live in the normal 60-slot actor table, so nothing grows past what the
+ * game already allocates (if the table is full, no copy is made). The snapshots are kept
+ * in Expansion Pak RAM.
+ * ---------------------------------------------------------------------- */
+
+#define CF_MORE_RAM 0x80600000
+#define CF_MORE_QUEUE 24
+#define CF_MORE_DELAY 14       /* frames between the original and its copy */
+#define CF_MORE_GROUP_WINDOW 6 /* spawns this close together count as one group */
+#define CF_MORE_MAX_GROUP 99 /* no group limit: every eligible enemy is doubled */
+#define CF_MORE_STILL_DIST 40.0f /* moved less than this during the delay = stationary */
+#define CF_MORE_SIDE_OFFSET 300.0f
+#define CF_MORE_FIRST_SLOT 10
+
+typedef struct CfMoreEntry {
+    Actor snap;
+    s32 frame;
+    s32 orig;
+    u32 serial;
+    u8 used;
+    u8 decision; /* 0 undecided, 1 copy, 2 skip */
+    u8 copiesLeft;
+} CfMoreEntry;
+
+u8 gCfActorClone[ARRAY_COUNT(gActors)];
+static u32 sCfSlotSerial[ARRAY_COUNT(gActors)];
+static u8 sCfAllRangeSeen[ARRAY_COUNT(gActors)];
+static s32 sCfMoreSide = 1;
+static u32 sCfSerialNext = 1;
+
+static CfMoreEntry* CustomFox_MoreQueue(void) {
+    if (osMemSize < 0x800000) {
+        return NULL;
+    }
+    return (CfMoreEntry*) CF_MORE_RAM;
+}
+
+/* How many extra copies of each enemy: 1 = double, 2 = triple. */
+static s32 CustomFox_MoreCopies(void) {
+    if (gCustomFoxMisc[CFMISC_TRIPLE_ENEMIES] || CustomFox_IsRevenge()) {
+        return 2; /* Andross's Revenge always plays with triple enemies */
+    }
+    if (gCustomFoxMisc[CFMISC_MORE_ENEMIES]) {
+        return 1;
+    }
+    return 0;
+}
+
+bool CustomFox_MoreEnemiesOn(void) {
+    return !gVersusMode && (CustomFox_MoreCopies() > 0) && (CustomFox_MoreQueue() != NULL) &&
+           (gCurrentLevel != LEVEL_TRAINING);
+}
+
+static void CustomFox_MoreEnemiesReset(void) {
+    CfMoreEntry* q = CustomFox_MoreQueue();
+    s32 i;
+
+    if (q == NULL) {
+        return;
+    }
+    for (i = 0; i < CF_MORE_QUEUE; i++) {
+        q[i].used = false;
+    }
+}
+
+/* Clears the copy flag whenever an actor slot is reused. */
+void CustomFox_ActorInit(Actor* actor) {
+    s32 idx = actor - gActors;
+
+    if ((idx >= 0) && (idx < ARRAY_COUNT(gActors))) {
+        gCfActorClone[idx] = false;
+        sCfSlotSerial[idx] = 0;
+        sCfAllRangeSeen[idx] = false;
+    }
+}
+
+/* Regular enemies that are safe and fair to copy. */
+static bool CustomFox_MoreEnemyType(s32 eventType) {
+    switch (eventType) {
+        case EVID_VENOM_FIGHTER_1:
+        case EVID_VENOM_FIGHTER_2:
+        case EVID_VENOM_FIGHTER_3:
+        case EVID_SPY_EYE:
+        case EVID_GRANGA_FIGHTER_1:
+        case EVID_GRANGA_FIGHTER_2:
+        case EVID_FIREBIRD:
+        case EVID_VENOM_TANK:
+        case EVID_TRIPOD:
+        case EVID_ATTACKER_1:
+        case EVID_ATTACKER_2:
+        case EVID_ATTACKER_3:
+        case EVID_SX_SPY_EYE:
+        case EVID_SX_CANINE:
+        case EVID_TI_BOMBER:
+        case EVID_SX_BORZOI_FIGHTER:
+        case EVID_KILLER_BEE:
+        case EVID_COMMANDER:
+        case EVID_SPIDER:
+        case EVID_GAMMA_ON:
+        case EVID_GAMMA_OFF:
+        case EVID_ZO_PATROL_BOAT:
+        case EVID_ZO_BIRD:
+        case EVID_AQ_STARFISH:
+        case EVID_AQ_SHELL:
+        case EVID_SX_WARP_ENMY:
+            return true;
+        default:
+            return false;
+    }
+}
+
+/* Called at the end of ActorEvent_Load for every scripted actor the level spawns. */
+void CustomFox_EventSpawned(Actor* actor) {
+    CfMoreEntry* q = CustomFox_MoreQueue();
+    s32 idx = actor - gActors;
+    s32 i;
+
+    if ((idx < 0) || (idx >= ARRAY_COUNT(gActors))) {
+        return;
+    }
+    sCfSlotSerial[idx] = sCfSerialNext++;
+    if (!CustomFox_MoreEnemiesOn() || (gPlayer[0].state != PLAYERSTATE_ACTIVE) || gCfActorClone[idx]) {
+        return;
+    }
+    for (i = 0; i < CF_MORE_QUEUE; i++) {
+        if (!q[i].used) {
+            q[i].snap = *actor;
+            q[i].frame = gGameFrameCount;
+            q[i].orig = idx;
+            q[i].serial = sCfSlotSerial[idx];
+            q[i].decision = 0;
+            q[i].copiesLeft = CustomFox_MoreCopies();
+            q[i].used = true;
+            return;
+        }
+    }
+}
+
+/* What the original turned out to be (it has run its script for a while by now). */
+static bool CustomFox_MoreEligible(CfMoreEntry* e) {
+    Actor* orig = &gActors[e->orig];
+    s32 eventType = e->snap.eventType;
+    s32 team = e->snap.iwork[EVA_TEAM_ID];
+
+    s32 health = e->snap.health;
+
+    if ((sCfSlotSerial[e->orig] == e->serial) && (orig->obj.status != OBJ_FREE) && (orig->obj.id == OBJ_ACTOR_EVENT)) {
+        eventType = orig->eventType;
+        team = orig->iwork[EVA_TEAM_ID];
+        health = orig->health;
+    }
+    return CustomFox_MoreEnemyType(eventType) && (team == 0) && (health > 0) && (e->snap.obj.status == OBJ_ACTIVE);
+}
+
+static void CustomFox_MoreDecideGroup(CfMoreEntry* q, CfMoreEntry* e) {
+    s32 i;
+    s32 count = 0;
+    s32 d;
+
+    for (i = 0; i < CF_MORE_QUEUE; i++) {
+        d = q[i].frame - e->frame;
+        if (q[i].used && (q[i].decision == 0) && (d <= CF_MORE_GROUP_WINDOW) && (d >= -CF_MORE_GROUP_WINDOW)) {
+            if (CustomFox_MoreEligible(&q[i])) {
+                q[i].decision = 1;
+                count++;
+            } else {
+                q[i].decision = 2;
+            }
+        }
+    }
+    if (count > CF_MORE_MAX_GROUP) { /* a big formation: leave it as the game made it */
+        for (i = 0; i < CF_MORE_QUEUE; i++) {
+            d = q[i].frame - e->frame;
+            if (q[i].used && (q[i].decision == 1) && (d <= CF_MORE_GROUP_WINDOW) && (d >= -CF_MORE_GROUP_WINDOW)) {
+                q[i].decision = 2;
+            }
+        }
+    }
+}
+
+static void CustomFox_MoreSpawn(CfMoreEntry* e) {
+    s32 j;
+    Actor* a;
+    Actor* orig = &gActors[e->orig];
+    bool still = false;
+
+    /* an original that stayed put (turret, parked unit) gets its twin beside it */
+    if ((sCfSlotSerial[e->orig] == e->serial) && (orig->obj.status == OBJ_ACTIVE)) {
+        still = (SQ(orig->obj.pos.x - e->snap.obj.pos.x) + SQ(orig->obj.pos.y - e->snap.obj.pos.y) +
+                 SQ(orig->obj.pos.z - e->snap.obj.pos.z)) < SQ(CF_MORE_STILL_DIST);
+    }
+
+    for (j = ARRAY_COUNT(gActors) - 1; j >= CF_MORE_FIRST_SLOT; j--) {
+        if (gActors[j].obj.status == OBJ_FREE) {
+            a = &gActors[j];
+            *a = e->snap;
+            a->index = j;
+            a->iwork[EVA_GROUP_ID] = 0;
+            a->iwork[EVA_GROUP_FLAG] = 0;
+            a->lockOnTimers[0] = a->lockOnTimers[1] = a->lockOnTimers[2] = a->lockOnTimers[3] = 0;
+            if (still) {
+                a->obj.pos.x += CF_MORE_SIDE_OFFSET * sCfMoreSide;
+                sCfMoreSide = -sCfMoreSide;
+            }
+            gCfActorClone[j] = true;
+            sCfSlotSerial[j] = 0;
+            return;
+        }
+    }
+}
+
+/* ---- all-range enemy fighters ---- */
+
+static bool CustomFox_MoreAllRangeType(Actor* a) {
+    if ((a->obj.id != OBJ_ACTOR_ALLRANGE) || (a->aiType < AI360_ENEMY) || (a->aiType >= AI360_GREAT_FOX) ||
+        (a->health <= 0) || CustomFox_IsAlly(a)) {
+        return false;
+    }
+    switch (gCurrentLevel) {
+        case LEVEL_KATINA:
+            return a->animFrame == 0; /* Katina: only the enemy fighters, not the Cornerian ones */
+        case LEVEL_VENOM_2:
+        case LEVEL_VENOM_ANDROSS:
+        case LEVEL_TRAINING:
+            return false;
+        default:
+            return true;
+    }
+}
+
+static void CustomFox_MoreAllRange(void) {
+    s32 i;
+    s32 j;
+    s32 n;
+    Actor* a;
+
+    for (i = AI360_ENEMY; i < ARRAY_COUNT(gActors); i++) {
+        a = &gActors[i];
+        if ((a->obj.status != OBJ_ACTIVE) || sCfAllRangeSeen[i]) {
+            continue;
+        }
+        sCfAllRangeSeen[i] = true;
+        if (gCfActorClone[i] || !CustomFox_MoreAllRangeType(a)) {
+            continue;
+        }
+        for (n = 0; n < CustomFox_MoreCopies(); n++) {
+        for (j = ARRAY_COUNT(gActors) - 1; j >= 30; j--) {
+            if (gActors[j].obj.status == OBJ_FREE) {
+                gActors[j] = *a;
+                gActors[j].index = j;
+                gActors[j].aiType = j;
+                gActors[j].obj.pos.x += 250.0f * sCfMoreSide * (n + 1);
+                gActors[j].lockOnTimers[0] = gActors[j].lockOnTimers[1] = gActors[j].lockOnTimers[2] =
+                    gActors[j].lockOnTimers[3] = 0;
+                sCfMoreSide = -sCfMoreSide;
+                gCfActorClone[j] = true;
+                sCfAllRangeSeen[j] = true;
+                break;
+            }
+        }
+        }
+    }
+}
+
+/* ---- level enemies with their own AI, loaded from the level object list ---- */
+static bool CustomFox_MoreLevelActorType(s32 id) {
+    if (gCurrentLevel == LEVEL_MACBETH) {
+        return false; /* leave the Macbeth train and everything on it alone */
+    }
+    switch (id) {
+        case OBJ_ACTOR_CO_GARUDA_1:
+        case OBJ_ACTOR_CO_GARUDA_2:
+        case OBJ_ACTOR_CO_GARUDA_3:
+        case OBJ_ACTOR_CO_SKIBOT:
+        case OBJ_ACTOR_ME_LASER_CANNON_1:
+        case OBJ_ACTOR_ME_LASER_CANNON_2:
+        case OBJ_ACTOR_ME_HOPBOT:
+        case OBJ_ACTOR_SY_ROBOT:
+        case OBJ_ACTOR_TI_DESERT_ROVER:
+        case OBJ_ACTOR_TI_DELPHOR:
+        case OBJ_ACTOR_TI_DESERT_CRAWLER:
+        case OBJ_ACTOR_TI_RASCO:
+        case OBJ_ACTOR_TI_FEKUDA:
+        case OBJ_ACTOR_ZO_BIRD:
+        case OBJ_ACTOR_ZO_FISH:
+        case OBJ_ACTOR_ZO_TROIKA:
+        case OBJ_ACTOR_ZO_SHRIMP:
+        case OBJ_ACTOR_AQ_ANGLERFISH:
+        case OBJ_ACTOR_AQ_GAROA:
+        case OBJ_ACTOR_AQ_SCULPIN:
+        case OBJ_ACTOR_AQ_SPINDLYFISH:
+        case OBJ_ACTOR_AQ_SQUID:
+        case OBJ_ACTOR_BO_LASER_CANNON:
+            return true;
+        default:
+            return false;
+    }
+}
+
+/* Called from Object_Load right after a level actor was loaded. */
+void CustomFox_MoreLevelActor(ObjectInit* objInit) {
+    ObjectInit copy;
+    s32 i;
+    s32 n;
+
+    if (!CustomFox_MoreEnemiesOn() || !CustomFox_MoreLevelActorType(objInit->id)) {
+        return;
+    }
+    for (n = 0; n < CustomFox_MoreCopies(); n++) {
+        copy = *objInit;
+        copy.xPos += CF_MORE_SIDE_OFFSET * sCfMoreSide; /* triple: one on each side */
+        sCfMoreSide = -sCfMoreSide;
+        for (i = ARRAY_COUNT(gActors) - 1; i >= 4; i--) {
+            if (gActors[i].obj.status == OBJ_FREE) {
+                Actor_Load(&gActors[i], &copy);
+                gCfActorClone[i] = true;
+                break;
+            }
+        }
+    }
+}
+
+/* Once per frame from CustomFox_PlayUpdate. */
+void CustomFox_MoreEnemiesUpdate(void) {
+    CfMoreEntry* q = CustomFox_MoreQueue();
+    s32 i;
+
+    if (q == NULL) {
+        return;
+    }
+    if (!CustomFox_MoreEnemiesOn() || (gPlayer[0].state != PLAYERSTATE_ACTIVE) || gKillEventActors) {
+        CustomFox_MoreEnemiesReset();
+        return;
+    }
+    if (gLevelMode == LEVELMODE_ALL_RANGE) {
+        CustomFox_MoreAllRange();
+    }
+    for (i = 0; i < CF_MORE_QUEUE; i++) {
+        if (q[i].used && ((s32) (gGameFrameCount - q[i].frame) >= CF_MORE_DELAY)) {
+            if (q[i].decision == 0) {
+                CustomFox_MoreDecideGroup(q, &q[i]);
+            }
+            if (q[i].decision == 1) {
+                CustomFox_MoreSpawn(&q[i]);
+                if (q[i].copiesLeft > 1) { /* triple: the next copy trails the first one */
+                    q[i].copiesLeft--;
+                    q[i].frame += CF_MORE_DELAY;
+                    continue;
+                }
+            }
+            q[i].used = false;
+        }
+    }
+}
+
+/* Script commands a copy must not run (they belong to the original only). */
+bool CustomFox_CloneSkipOp(Actor* actor, s32 opcode) {
+    s32 idx = actor - gActors;
+
+    if ((idx < 0) || (idx >= ARRAY_COUNT(gActors)) || !gCfActorClone[idx]) {
+        return false;
+    }
+    return (opcode == EV_OPC(EVOP_PLAY_MSG)) || (opcode == EV_OPC(EVOP_SET_CALL)) ||
+           (opcode == EV_OPC(EVOP_DAMAGE_TEAM)) || (opcode == EV_OPC(EVOP_RESTORE_TEAM)) ||
+           (opcode == EV_OPC(EVOP_STOP_BGM)) || (opcode == EV_OPC(EVOP_SET_REVERB)) ||
+           (opcode == EV_OPC(EVOP_SET_SURFACE)) || (opcode == EV_OPC(EVOP_ADD_TO_GROUP)) ||
+           (opcode == EV_OPC(EVOP_SET_AS_LEADER));
+}
+
+/* ----------------------------------------------------------------------
+ * VEHICLE UPGRADES (Misc toggle, every mode)
+ *   Blue Marine: hold A / B for rapid lasers and torpedoes, torpedoes lock up to 3
+ *                enemies and their blast covers 4x the area (fox_aq.c)
+ *   Landmaster:  a new bomb every 10 seconds
+ * ---------------------------------------------------------------------- */
+#define CF_TANK_BOMB_FRAMES (30 * 10)
+static s32 sCfTankBombTimer = 0;
+
+bool CustomFox_VehicleUpgrades(void) {
+    return !gVersusMode && gCustomFoxMisc[CFMISC_VEHICLES];
+}
+
+f32 CustomFox_TorpedoFxScale(void) {
+    return CustomFox_VehicleUpgrades() ? 2.0f : 1.0f;
+}
+
+void CustomFox_VehicleUpdate(void) {
+    Player* player = &gPlayer[0];
+
+    if (!CustomFox_VehicleUpgrades() || (player->form != FORM_LANDMASTER) || (player->state != PLAYERSTATE_ACTIVE)) {
+        sCfTankBombTimer = 0;
+        return;
+    }
+    sCfTankBombTimer++;
+    if (sCfTankBombTimer >= CF_TANK_BOMB_FRAMES) {
+        sCfTankBombTimer = 0;
+        if (gBombCount[0] < 9) {
+            gBombCount[0]++;
+            AUDIO_PLAY_SFX(NA_SE_BOMB_GET, gDefaultSfxSource, 4);
+        }
+    }
+}
+
+/* ----------------------------------------------------------------------
+ * SKIP CUTSCENES (Misc toggle)
+ *   - mission intros are skipped the same way START skips them on a cleared planet
+ *   - after a mission, the results screen comes up right away (it still adds up the
+ *     hits, extra lives and team status), then the game goes straight to the map
+ *   - the ending and credits go straight to the final results
+ * ---------------------------------------------------------------------- */
+bool CustomFox_SkipCutscenes(void) {
+    return !gVersusMode && gCustomFoxMisc[CFMISC_SKIP_CUTSCENES];
+}
+
+static s32 CustomFox_MedalHits(void) {
+    switch (gCurrentLevel) {
+        case LEVEL_METEO:
+        case LEVEL_VENOM_ANDROSS:
+        case LEVEL_VENOM_2:
+            return 200;
+        case LEVEL_FORTUNA:
+            return 50;
+        case LEVEL_SOLAR:
+        case LEVEL_SECTOR_Z:
+            return 100;
+        case LEVEL_ZONESS:
+            return 250;
+        case LEVEL_AREA_6:
+            return 300;
+        default:
+            return 150;
+    }
+}
+
+/*
+ * Called every frame while the player is in PLAYERSTATE_LEVEL_COMPLETE (after the level's own
+ * cutscene code). Pressing START skips ahead: the results screen is shown if the cutscene hasn't
+ * shown it yet (it adds up the hits, lives and team), then the game goes to the map.
+ */
+static bool sCfOutroSkipping = false;
+static bool sCfResultsSeen = false;
+static bool sCfResultsOurs = false;
+
+void CustomFox_SkipOutro(Player* player) {
+    if (player->num != 0) {
+        return;
+    }
+    if (gCsFrameCount < 2) {
+        sCfOutroSkipping = sCfResultsSeen = sCfResultsOurs = false;
+        sCfOutroTimer = 0;
+    }
+    if (gShowLevelClearStatusScreen && !sCfResultsOurs) {
+        sCfResultsSeen = true;
+    }
+    if (!CustomFox_SkipCutscenes()) {
+        return;
+    }
+    switch (gCurrentLevel) { /* these flow into Andross, the ending or save from their own cutscene */
+        case LEVEL_VENOM_1:
+        case LEVEL_VENOM_2:
+        case LEVEL_VENOM_ANDROSS:
+        case LEVEL_TRAINING:
+        case LEVEL_BOLSE:
+        case LEVEL_AREA_6:
+            return;
+    }
+    if (!sCfOutroSkipping) {
+        if (!(gControllerPress[gMainController].button & START_BUTTON) || (gCsFrameCount < 10)) {
+            return;
+        }
+        sCfOutroSkipping = true;
+        sCfOutroTimer = 0;
+        sCfResultsOurs = !sCfResultsSeen;
+    }
+    sCfOutroTimer++;
+    if (sCfResultsOurs && (sCfOutroTimer < 210)) {
+        gShowLevelClearStatusScreen = true; /* results: hits, lives, team */
+        return;
+    }
+    if (!sCfResultsOurs && gShowLevelClearStatusScreen) {
+        return; /* the level's own results screen is up: let it finish */
+    }
+    gShowLevelClearStatusScreen = false;
+    gFillScreenRed = gFillScreenGreen = gFillScreenBlue = 0;
+    gFillScreenAlphaTarget = 255;
+    gFillScreenAlphaStep = 16;
+    if (gFillScreenAlpha == 255) {
+        gLeveLClearStatus[gCurrentLevel] = Play_CheckMedalStatus(CustomFox_MedalHits()) + 1;
+        Audio_FadeOutAll(10);
+        player->state = PLAYERSTATE_NEXT;
+        player->csTimer = 0;
+        gFadeoutType = 4;
+        sCfOutroSkipping = false;
+    }
+}
+
+/* Called before Ending_Main: jump from the ending straight to the final results. */
+bool CustomFox_SkipCredits(void) {
+    /* START always skips the ending and credits, whether or not Skip Cutscenes is on.
+     * The credits lock the controller, so the joybus code also watches START for us then. */
+    extern u8 gCfLockedStart;
+    bool start = gCfLockedStart || (gControllerPress[gMainController].button & START_BUTTON);
+
+    gCfLockedStart = 0;
+    if (gVersusMode || !start) {
+        return false;
+    }
+    Audio_FadeOutAll(10);
+    gLastGameState = GSTATE_ENDING;
+    gGameState = GSTATE_MENU;
+    gNextGameStateTimer = 2;
+    gOptionMenuStatus = OPTION_WAIT;
+    gDrawMode = DRAW_NONE;
+    gBgColor = 0;
+    gStarCount = 0;
+    gControllerLock = 10;
+    return true;
+}
+
+/* ----------------------------------------------------------------------
+ * ENEMY AGGRESSION (Hard: 2x fire rate + fast shots, Andross's Revenge: 3x + fast shots)
+ * Every enemy shot is followed by 1 (Hard) or 2 (Revenge) more from the same spot a few
+ * frames later, aimed again. All-range fighters also shoot from further away, check for a
+ * shot more often and turn harder in Andross's Revenge.
+ * ---------------------------------------------------------------------- */
+#define CF_BURST_SLOTS 16
+#define CF_BURST_GAP 5
+
+typedef struct CfBurst {
+    s32 objId;
+    f32 args[13];
+    s16 timer;
+    u8 kind; /* 0 shoot at player, 1 shoot at camera, 2 forward laser */
+    u8 left;
+} CfBurst;
+
+static CfBurst sCfBursts[CF_BURST_SLOTS];
+static bool sCfBurstReplay = false;
+static u8 sCfArBurstLeft[ARRAY_COUNT(gActors)];
+static u8 sCfArBurstTimer[ARRAY_COUNT(gActors)];
+static u8 sCfArReplay[ARRAY_COUNT(gActors)];
+
+static s32 CustomFox_BurstExtras(void) {
+    if (gVersusMode) {
+        return 0;
+    }
+    if (CustomFox_IsRevenge()) {
+        return 2;
+    }
+    if (CustomFox_IsHard()) {
+        return 1;
+    }
+    return 0;
+}
+
+bool CustomFox_FastEnemyShots(void) {
+    return CustomFox_IsHard(); /* Hard and Andross's Revenge */
+}
+
+void CustomFox_EnemyShotFired(s32 kind, s32 objId, f32* args) {
+    s32 i;
+    s32 n = (kind == 2) ? 13 : 4;
+    s32 extras = CustomFox_BurstExtras();
+
+    if (sCfBurstReplay || (extras == 0) || (gPlayer[0].state != PLAYERSTATE_ACTIVE)) {
+        return;
+    }
+    for (i = 0; i < CF_BURST_SLOTS; i++) {
+        if (sCfBursts[i].left == 0) {
+            sCfBursts[i].kind = kind;
+            sCfBursts[i].objId = objId;
+            for (n--; n >= 0; n--) {
+                sCfBursts[i].args[n] = args[n];
+            }
+            sCfBursts[i].left = extras;
+            sCfBursts[i].timer = CF_BURST_GAP;
+            return;
+        }
+    }
+}
+
+void CustomFox_AllRangeFired(Actor* actor) {
+    s32 idx = actor - gActors;
+
+    if ((idx < 0) || (idx >= ARRAY_COUNT(gActors))) {
+        return;
+    }
+    if (sCfArReplay[idx]) {
+        sCfArReplay[idx] = false;
+        return;
+    }
+    if ((actor->aiType == AI360_FOX) || (actor->aiType >= AI360_GREAT_FOX)) {
+        return; /* fighters (enemies, Star Wolf and the team): not missiles */
+    }
+    sCfArBurstLeft[idx] = CustomFox_BurstExtras();
+    sCfArBurstTimer[idx] = CF_BURST_GAP;
+}
+
+void CustomFox_AllRangeAggro(Actor* actor, f32* fireChance, u8* fireMask, f32* fireRange) {
+    if (!CustomFox_IsHard() || (actor->aiType == AI360_FOX) || (actor->aiType >= AI360_GREAT_FOX)) {
+        return;
+    }
+    if (CustomFox_IsAlly(actor)) { /* Master / Andross's Revenge: the team fights harder too */
+        *fireChance *= CustomFox_IsRevenge() ? 1.6f : 1.35f;
+        if (*fireChance > 1.0f) {
+            *fireChance = 1.0f;
+        }
+        *fireMask &= CustomFox_IsRevenge() ? 3 : 7;
+        *fireRange *= 1.4f;
+        return;
+    }
+    if (!CustomFox_IsRevenge()) {
+        if (actor->aiType >= AI360_ENEMY) {
+            return; /* Hard: only the Star Wolf bosses get pushier */
+        }
+        *fireChance *= 1.3f;
+        if (*fireChance > 1.0f) {
+            *fireChance = 1.0f;
+        }
+        *fireMask &= 7;
+        *fireRange *= 1.25f;
+        return;
+    }
+    *fireChance *= 1.6f;
+    if (*fireChance > 1.0f) {
+        *fireChance = 1.0f;
+    }
+    *fireMask &= 3;      /* look for a shot every few frames instead of every ~12 */
+    *fireRange *= 1.5f;  /* open fire from further away */
+    if (actor->fwork[3] < 1.8f) { /* turn harder (capped so it can never build up) */
+        actor->fwork[3] *= 1.3f;
+        if (actor->fwork[3] > 1.8f) {
+            actor->fwork[3] = 1.8f;
+        }
+    }
+}
+
+/* Once per frame (CustomFox_PlayUpdate): fire the queued follow-up shots. */
+static void CustomFox_BurstUpdate(void) {
+    s32 i;
+    CfBurst* b;
+    Actor* a;
+
+    if ((gPlayer[0].state != PLAYERSTATE_ACTIVE) || (CustomFox_BurstExtras() == 0)) {
+        for (i = 0; i < CF_BURST_SLOTS; i++) {
+            sCfBursts[i].left = 0;
+        }
+        for (i = 0; i < ARRAY_COUNT(gActors); i++) {
+            sCfArBurstLeft[i] = 0;
+        }
+        return;
+    }
+    sCfBurstReplay = true;
+    for (i = 0, b = sCfBursts; i < CF_BURST_SLOTS; i++, b++) {
+        if ((b->left == 0) || (--b->timer > 0)) {
+            continue;
+        }
+        switch (b->kind) {
+            case 0:
+                Effect_ShootAtPlayer(b->objId, b->args[0], b->args[1], b->args[2], b->args[3]);
+                break;
+            case 1:
+                Effect_ShootAtCamera(b->objId, b->args[0], b->args[1], b->args[2], b->args[3]);
+                break;
+            default:
+                Effect_SpawnById2(b->objId, b->args[0], b->args[1], b->args[2], b->args[3], b->args[4], b->args[5],
+                                  b->args[6], b->args[7], b->args[8], b->args[9], b->args[10], b->args[11],
+                                  b->args[12]);
+                break;
+        }
+        b->left--;
+        b->timer = CF_BURST_GAP;
+    }
+    sCfBurstReplay = false;
+
+    for (i = 0, a = gActors; i < ARRAY_COUNT(gActors); i++, a++) {
+        if (sCfArBurstLeft[i] == 0) {
+            continue;
+        }
+        if ((a->obj.status != OBJ_ACTIVE) || (a->obj.id != OBJ_ACTOR_ALLRANGE)) {
+            sCfArBurstLeft[i] = 0;
+            continue;
+        }
+        if (--sCfArBurstTimer[i] == 0) {
+            a->iwork[0] = 1; /* the fighter fires again on its next update */
+            sCfArReplay[i] = true;
+            sCfArBurstLeft[i]--;
+            sCfArBurstTimer[i] = CF_BURST_GAP;
+        }
+    }
+}
+
+/* Collect All Items cheat: the Great Fox pickup ability on any ship. */
+void CustomFox_GreatFoxCollect(Player* player);
+void CustomFox_AutoCollect(Player* player) {
+    if (CF_ON(CF_AUTO_COLLECT) && (player->num == 0) && (player->state == PLAYERSTATE_ACTIVE) &&
+        !CustomFox_IsGreatFox(player)) {
+        CustomFox_GreatFoxCollect(player);
+    }
+}
diff --git a/src/mods/customfox_omega.inc.c b/src/mods/customfox_omega.inc.c
new file mode 100644
index 0000000..491dc59
--- /dev/null
+++ b/src/mods/customfox_omega.inc.c
@@ -0,0 +1,448 @@
+/*
+ * Custom Fox 64 - Arwing MK2 secret: the Omega Laser.
+ * #included near the bottom of src/engine/fox_play.c (main segment).
+ *
+ * L + C-Right fires the Area 6 boss's laser from the player's ship (Arwing, Landmaster or
+ * Blue Marine) when the Arwing MK2 is the selected ship. Every hit does 8x a laser hit.
+ *
+ * The beam model and texture live in the Area 6 asset bundle, which is copied once into
+ * Expansion Pak RAM; segment 6 is pointed at the copy only while the beam is drawn.
+ * Hits go through the game's own shot collision with a shot that is not in gPlayerShots,
+ * so every enemy and boss reacts to the beam exactly as it reacts to a laser.
+ */
+
+#include "assets/ast_area_6.h"
+
+#define CF_EXP_AREA6 0x80700000
+
+#define CF_OMEGA_CHARGE 20       /* frames of wind-up before it fires */
+#define CF_OMEGA_FIRE 90         /* 3 seconds of beam */
+#define CF_OMEGA_COOLDOWN 300    /* 10 seconds before it can fire again */
+#define CF_OMEGA_TICK 5          /* frames between damage passes */
+#define CF_OMEGA_LENGTH 8000.0f  /* beam reach */
+#define CF_OMEGA_WIDTH 1.2f      /* model is 80 units across: about 100 */
+#define CF_OMEGA_START 200.0f    /* the beam starts this far ahead of the nose */
+#define CF_OMEGA_RADIUS 150.0f   /* how far from the beam's center line a target can be touched */
+#define CF_OMEGA_DAMAGE_MULT 8
+#define CF_OMEGA_BOSS_REACH 2000.0f /* boss hitboxes are searched this far either side of the boss */
+#define CF_OMEGA_MAX_CALLS 12   /* enemy checks per damage pass */
+#define CF_OMEGA_BOSS_STEP 600.0f /* two interleaved passes of 300 (alternating damage passes) */
+
+s32 PlayerShot_CheckObjectHitbox(PlayerShot* shot, f32* hitboxData, Object* obj);
+s32 PlayerShot_CheckEventHitbox(PlayerShot* shot, Actor* actor);
+s32 PlayerShot_CheckActorHitbox(PlayerShot* shot, Actor* actor);
+void PlayerShot_ApplyDamageToActor(PlayerShot* shot, Actor* actor, s32 hitIndex);
+
+static bool sCfArea6Loaded = false;
+static s32 sCfOmegaTimer = 0; /* counts down through charge + fire */
+static s32 sCfOmegaCooldown = 0;
+static f32 sCfOmegaSpin = 0.0f;
+static Vec3f sCfOmegaPos;
+static Vec3f sCfOmegaDir;
+static PlayerShot sCfOmegaShot;
+static f32 sCfOmegaStop = CF_OMEGA_LENGTH; /* where a boss stopped the beam */
+static f32 sCfOmegaDrawLen = CF_OMEGA_LENGTH;
+bool gCfOmegaHitting = false; /* set while the beam's hits are applied (damage scaling, armor) */
+static u8 sCfOmegaPass = 0;
+static s32 sCfOmegaFirst = 0; /* actor slot the next damage pass starts from */
+s32 gCfOmegaHits = 0;            /* test builds: hits landed (debug HUD) */
+u32 gCfOmegaCostB = 0;           /* test builds: slowest boss part of a pass */
+u32 gCfOmegaCost = 0;            /* test builds: slowest damage pass, in 1000s of CPU counts */
+
+/* One-time copy of the Area 6 assets (the beam model) to Expansion Pak RAM. */
+static void CustomFox_LoadOmegaAssets(void) {
+    if (sCfArea6Loaded || (osMemSize < 0x800000)) {
+        return;
+    }
+    Load_RomFile(SEGMENT_ROM_START(ast_area_6), (void*) CF_EXP_AREA6, SEGMENT_ROM_SIZE(ast_area_6));
+    osWritebackDCacheAll();
+    sCfArea6Loaded = true;
+}
+
+void CustomFox_OmegaReset(void) {
+    sCfOmegaTimer = 0;
+    sCfOmegaCooldown = 0;
+}
+
+static bool CustomFox_OmegaAllowed(Player* player) {
+    return !gVersusMode && sCfArea6Loaded && (CustomFox_ActiveShip() == CFSHIP_ARWING_MK2) &&
+           (player->state == PLAYERSTATE_ACTIVE) &&
+           ((player->form == FORM_ARWING) || (player->form == FORM_LANDMASTER) ||
+            (player->form == FORM_BLUE_MARINE));
+}
+
+/* Where the beam starts and which way it points, taken from the ship's own laser setup. */
+static void CustomFox_OmegaAim(Player* player) {
+    PlayerShot* shot = &sCfOmegaShot;
+    f32 len;
+
+    if (player->form == FORM_LANDMASTER) {
+        Player_SetupTankShot(player, shot, PLAYERSHOT_TANK, 100.0f);
+    } else {
+        Player_SetupArwingShot(player, shot, 0.0f, 0.0f, PLAYERSHOT_TWIN_LASER, 100.0f);
+    }
+    len = sqrtf(SQ(shot->vel.x) + SQ(shot->vel.y) + SQ(shot->vel.z));
+    if (len < 1.0f) {
+        return;
+    }
+    sCfOmegaDir.x = shot->vel.x / len;
+    sCfOmegaDir.y = shot->vel.y / len;
+    sCfOmegaDir.z = shot->vel.z / len;
+    sCfOmegaPos.x = shot->obj.pos.x + sCfOmegaDir.x * CF_OMEGA_START;
+    sCfOmegaPos.y = shot->obj.pos.y + sCfOmegaDir.y * CF_OMEGA_START;
+    sCfOmegaPos.z = shot->obj.pos.z + sCfOmegaDir.z * CF_OMEGA_START;
+}
+
+/*
+ * Tests one enemy against a point of the beam, the same way PlayerShot_CollisionCheck tests a laser
+ * against that enemy (only that one, so a damage pass stays cheap), and applies the hit.
+ */
+static void CustomFox_OmegaHitActor(Actor* actor, f32 x, f32 y, f32 z) {
+    PlayerShot* shot = &sCfOmegaShot;
+    s32 col = 0;
+    Vec3f d;
+
+    shot->obj.status = SHOT_ACTIVE;
+    shot->obj.id = PLAYERSHOT_TWIN_LASER;
+    shot->sourceId = 0;
+    shot->obj.pos.x = x;
+    shot->obj.pos.y = y;
+    shot->obj.pos.z = z;
+    shot->vel.x = sCfOmegaDir.x * 100.0f;
+    shot->vel.y = sCfOmegaDir.y * 100.0f;
+    shot->vel.z = sCfOmegaDir.z * 100.0f;
+    gShotHitPosX = x;
+    gShotHitPosY = y;
+    gShotHitPosZ = z;
+    switch (actor->obj.id) {
+        case OBJ_ACTOR_ME_MOLAR_ROCK:
+            return; /* polygon collision: left to normal shots */
+        case OBJ_ACTOR_EVENT:
+            if (actor->eventType == EVID_SY_SHIP_2) {
+                return;
+            }
+            if (actor->eventType == EVID_ME_BIG_METEOR) {
+                d.x = actor->obj.pos.x - x;
+                d.y = actor->obj.pos.y - y;
+                d.z = actor->obj.pos.z - z;
+                if (VEC3F_MAG(&d) < 1000.0f) {
+                    PlayerShot_ApplyDamageToActor(shot, actor, 0);
+                }
+                return;
+            }
+            col = PlayerShot_CheckEventHitbox(shot, actor);
+            break;
+        default:
+            if (actor->info.unk_16 != 0) {
+                col = PlayerShot_CheckActorHitbox(shot, actor);
+            } else {
+                col = PlayerShot_CheckObjectHitbox(shot, actor->info.hitbox, &actor->obj);
+            }
+            break;
+    }
+    if (col != 0) {
+        PlayerShot_ApplyDamageToActor(shot, actor, col);
+    }
+}
+
+/* Called from PlayerShot_ApplyDamageToActor: Omega Laser hits go through armor and shields. */
+bool CustomFox_OmegaPierce(Actor* actor) {
+    if (!gCfOmegaHitting) {
+        return false;
+    }
+    if (gCurrentLevel == LEVEL_AQUAS) {
+        actor->damage = 31; /* hits like a torpedo, which every Aquas enemy (and boss part) reacts to */
+    } else {
+        actor->dmgType = DMG_EXPLOSION; /* hits like a charged shot */
+    }
+    return true;
+}
+
+/* Radius of a sphere around the object's center that holds all of its hitboxes. */
+static f32 CustomFox_HitboxReach(f32* hb) {
+    s32 count = *hb++;
+    s32 i;
+    f32 r;
+    f32 reach = 0.0f;
+
+    for (i = 0; i < count; i++, hb += 6) {
+        if (hb[0] >= HITBOX_SHADOW) {
+            break;
+        }
+        if (hb[0] == HITBOX_ROTATED) {
+            hb += 4;
+        }
+        r = sqrtf(SQ(hb[0]) + SQ(hb[2]) + SQ(hb[4])) + sqrtf(SQ(hb[1]) + SQ(hb[3]) + SQ(hb[5]));
+        if (r > reach) {
+            reach = r;
+        }
+    }
+    return reach + 60.0f; /* laser hit padding */
+}
+
+/* Boss hitboxes can sit far from the boss's center, so step along the beam through them. */
+static void CustomFox_OmegaHitBoss(Boss* boss, f32 tCenter) {
+    PlayerShot* shot = &sCfOmegaShot;
+    f32 t;
+    f32 tEnd;
+    f32 reach;
+    Vec3f p;
+    s32 col;
+
+    if ((boss->obj.id == OBJ_BOSS_FO_BASE) || (boss->obj.id == OBJ_BOSS_VE2_BASE) ||
+        (boss->obj.id == OBJ_BOSS_BO_BASE) || (boss->obj.id == OBJ_BOSS_SZ_GREAT_FOX) ||
+        (boss->obj.id == OBJ_BOSS_BO_BASE_SHIELD)) {
+        return; /* bases are destroyed through their own parts */
+    }
+    reach = CustomFox_HitboxReach(boss->info.hitbox);
+    if (reach > CF_OMEGA_BOSS_REACH) {
+        reach = CF_OMEGA_BOSS_REACH;
+    }
+    t = tCenter - reach + ((sCfOmegaPass & 1) ? (CF_OMEGA_BOSS_STEP / 2) : 0.0f);
+    if (t < 0.0f) {
+        t = 0.0f;
+    }
+    tEnd = tCenter + reach;
+    if (tEnd > CF_OMEGA_LENGTH) {
+        tEnd = CF_OMEGA_LENGTH;
+    }
+    /* front to back, so the first part the beam touches takes the hit (and the search stops early) */
+    for (; t <= tEnd; t += CF_OMEGA_BOSS_STEP) {
+        p.x = sCfOmegaPos.x + sCfOmegaDir.x * t - boss->obj.pos.x;
+        p.y = sCfOmegaPos.y + sCfOmegaDir.y * t - boss->obj.pos.y;
+        p.z = sCfOmegaPos.z + sCfOmegaDir.z * t - boss->obj.pos.z;
+        if ((SQ(p.x) + SQ(p.y) + SQ(p.z)) > SQ(reach)) {
+            continue; /* this point can't touch any of the boss's hitboxes */
+        }
+        shot->obj.status = SHOT_ACTIVE;
+        shot->obj.id = PLAYERSHOT_TWIN_LASER;
+        shot->sourceId = 0;
+        shot->obj.pos.x = sCfOmegaPos.x + sCfOmegaDir.x * t;
+        shot->obj.pos.y = sCfOmegaPos.y + sCfOmegaDir.y * t;
+        shot->obj.pos.z = sCfOmegaPos.z + sCfOmegaDir.z * t;
+        col = PlayerShot_CheckObjectHitbox(shot, boss->info.hitbox, &boss->obj);
+        if (col != 0) {
+            /* same as a laser hit in PlayerShot_CollisionCheck */
+            boss->dmgType = DMG_BEAM;
+            boss->damage = (gLaserStrength[0] == LASERS_HYPER) ? 15 : 10;
+            boss->damage = CustomFox_ShipLaserDamage(boss->damage, shot);
+            boss->damage = CustomFox_ScaleDamage(boss->damage, 0);
+            boss->dmgPart = col - 1;
+            if (gCurrentLevel == LEVEL_AQUAS) {
+                boss->damage = 31; /* Aquas boss parts only react to torpedo hits (damage 31) */
+            }
+            if (t < sCfOmegaStop) {
+                sCfOmegaStop = t; /* the beam is drawn up to here */
+            }
+            if (boss->obj.id == OBJ_BOSS_SY_SHOGUN) {
+                boss->swork[19] = 0;
+            } else if (boss->obj.id == OBJ_BOSS_AQ_UNK_301) {
+                boss->swork[5] = (gCurrentLevel == LEVEL_AQUAS) ? PLAYERSHOT_LOCK_ON : shot->obj.id;
+            } else if (boss->obj.id == OBJ_BOSS_VE1_GOLEMECH) {
+                boss->fwork[47] = shot->obj.pos.x;
+                boss->fwork[48] = shot->obj.pos.y;
+                boss->fwork[49] = shot->obj.pos.z;
+            }
+#if CF_TEST_DEFAULTS == 1
+            gCfOmegaHits += 100;
+#endif
+            return;
+        }
+    }
+}
+
+static void CustomFox_OmegaDamage(void) {
+    Actor* actor;
+    Boss* boss;
+    Vec3f d;
+    f32 t;
+    f32 dist;
+    f32 k;
+    s32 i;
+    s32 calls = 0;
+    s32 j;
+#if CF_TEST_DEFAULTS == 1
+    u32 cfT0;
+#endif
+
+    gCfOmegaHitting = true;
+    sCfOmegaStop = CF_OMEGA_LENGTH;
+    sCfOmegaPass++;
+    for (j = 0; j < ARRAY_COUNT(gActors); j++) {
+        i = (sCfOmegaFirst + j) % ARRAY_COUNT(gActors);
+        actor = &gActors[i];
+        if ((actor->obj.status != OBJ_ACTIVE) || (actor->timer_0C2 != 0) || CustomFox_IsAlly(actor)) {
+            continue;
+        }
+        d.x = actor->obj.pos.x - sCfOmegaPos.x;
+        d.y = actor->obj.pos.y - sCfOmegaPos.y;
+        d.z = actor->obj.pos.z - sCfOmegaPos.z;
+        t = d.x * sCfOmegaDir.x + d.y * sCfOmegaDir.y + d.z * sCfOmegaDir.z;
+        if ((t < 0.0f) || (t > CF_OMEGA_LENGTH)) {
+            continue;
+        }
+        d.x -= sCfOmegaDir.x * t; /* offset from the beam's center line */
+        d.y -= sCfOmegaDir.y * t;
+        d.z -= sCfOmegaDir.z * t;
+        dist = sqrtf(SQ(d.x) + SQ(d.y) + SQ(d.z));
+        if (dist > 700.0f) {
+            continue;
+        }
+        if (++calls > CF_OMEGA_MAX_CALLS) {
+            sCfOmegaFirst = i; /* keep each damage pass cheap: the rest are checked first next pass */
+            break;
+        }
+        k = (dist > CF_OMEGA_RADIUS) ? (CF_OMEGA_RADIUS / dist) : 1.0f;
+        CustomFox_OmegaHitActor(actor, sCfOmegaPos.x + sCfOmegaDir.x * t + d.x * k,
+                                sCfOmegaPos.y + sCfOmegaDir.y * t + d.y * k,
+                                sCfOmegaPos.z + sCfOmegaDir.z * t + d.z * k);
+#if CF_TEST_DEFAULTS == 1
+        if (actor->dmgType != DMG_NONE) {
+            gCfOmegaHits++;
+        }
+#endif
+    }
+#if CF_TEST_DEFAULTS == 1
+    cfT0 = osGetCount();
+#endif
+    for (i = 0, boss = gBosses; i < ARRAY_COUNT(gBosses); i++, boss++) {
+        if ((boss->obj.status != OBJ_ACTIVE) || (boss->timer_05A != 0)) {
+            continue;
+        }
+        d.x = boss->obj.pos.x - sCfOmegaPos.x;
+        d.y = boss->obj.pos.y - sCfOmegaPos.y;
+        d.z = boss->obj.pos.z - sCfOmegaPos.z;
+        t = d.x * sCfOmegaDir.x + d.y * sCfOmegaDir.y + d.z * sCfOmegaDir.z;
+        if ((t < -3000.0f) || (t > CF_OMEGA_LENGTH + 3000.0f)) {
+            continue;
+        }
+        CustomFox_OmegaHitBoss(boss, t);
+    }
+#if CF_TEST_DEFAULTS == 1
+    cfT0 = (osGetCount() - cfT0) / 1000;
+    if (cfT0 > gCfOmegaCostB) {
+        gCfOmegaCostB = cfT0;
+    }
+#endif
+    gCfOmegaHitting = false;
+}
+
+/* Per frame, from CustomFox_PlayUpdate. */
+static void CustomFox_OmegaUpdate(Player* player) {
+    u16 hold = gControllerHold[gMainController].button;
+    u16 press = gControllerPress[gMainController].button;
+    s32 fireFrame;
+
+    if (sCfOmegaCooldown > 0) {
+        sCfOmegaCooldown--;
+    }
+    if (!CustomFox_OmegaAllowed(player)) {
+        if (sCfOmegaTimer > 0) {
+            Audio_KillSfxBySourceAndId(player->sfxSource, NA_SE_EN_A6BOSS_BEAM);
+        }
+        sCfOmegaTimer = 0;
+        return;
+    }
+
+    if (sCfOmegaTimer == 0) {
+        if (((hold & (L_TRIG | R_CBUTTONS)) == (L_TRIG | R_CBUTTONS)) && (press & (L_TRIG | R_CBUTTONS))) {
+            if (sCfOmegaCooldown > 0) {
+                AUDIO_PLAY_SFX(NA_SE_ERROR, gDefaultSfxSource, 4);
+            } else {
+                sCfOmegaTimer = CF_OMEGA_CHARGE + CF_OMEGA_FIRE;
+                sCfOmegaStop = CF_OMEGA_LENGTH;
+                AUDIO_PLAY_SFX(NA_SE_EN_A6BOSS_CHARGE, player->sfxSource, 0);
+            }
+        }
+        return;
+    }
+
+    sCfOmegaTimer--;
+    CustomFox_OmegaAim(player);
+    sCfOmegaDrawLen = sCfOmegaStop + 250.0f; /* stop the beam inside the boss it is hitting */
+    if (sCfOmegaDrawLen > CF_OMEGA_LENGTH) {
+        sCfOmegaDrawLen = CF_OMEGA_LENGTH;
+    }
+    sCfOmegaSpin += 30.0f;
+    fireFrame = CF_OMEGA_FIRE - sCfOmegaTimer; /* 1.. once the beam is out */
+
+    if (fireFrame == 1) {
+        Audio_KillSfxBySourceAndId(player->sfxSource, NA_SE_EN_A6BOSS_CHARGE);
+        AUDIO_PLAY_SFX(NA_SE_EN_A6BOSS_BEAM, player->sfxSource, 0);
+        gFillScreenRed = gFillScreenGreen = gFillScreenBlue = 255;
+        gFillScreenAlpha = 120;
+        gFillScreenAlphaTarget = 0;
+        gFillScreenAlphaStep = 20;
+    }
+    if (fireFrame >= 1) {
+        gCameraShake = 3;
+        if ((fireFrame % CF_OMEGA_TICK) == 1) {
+#if CF_TEST_DEFAULTS == 1
+            u32 c0 = osGetCount();
+            CustomFox_OmegaDamage();
+            c0 = (osGetCount() - c0) / 1000;
+            if (c0 > gCfOmegaCost) {
+                gCfOmegaCost = c0;
+            }
+#else
+            CustomFox_OmegaDamage();
+#endif
+        }
+    }
+    if (sCfOmegaTimer == 0) {
+        Audio_KillSfxBySourceAndId(player->sfxSource, NA_SE_EN_A6BOSS_BEAM);
+        sCfOmegaCooldown = CF_OMEGA_COOLDOWN;
+    }
+}
+
+/* Drawn with the player's shots (PlayerShot_DrawAll), in world space. */
+void CustomFox_OmegaDraw(void) {
+    f32 width;
+    f32 len;
+    s32 fireFrame;
+    u32 savedSeg6;
+
+    if ((sCfOmegaTimer == 0) || (gReflectY < 0) || !sCfArea6Loaded) {
+        return;
+    }
+    fireFrame = CF_OMEGA_FIRE - sCfOmegaTimer;
+    if (fireFrame < 1) {
+        /* wind-up: a short, thin, growing stub */
+        width = 0.15f + 0.35f * (CF_OMEGA_CHARGE + fireFrame) / CF_OMEGA_CHARGE;
+        len = 150.0f;
+    } else {
+        width = CF_OMEGA_WIDTH;
+        if (fireFrame < 6) {
+            width *= fireFrame / 6.0f;
+        }
+        if (sCfOmegaTimer < 10) {
+            width *= sCfOmegaTimer / 10.0f;
+        }
+        len = sCfOmegaDrawLen;
+        if (fireFrame < 4) {
+            len *= fireFrame / 4.0f;
+        }
+    }
+
+    savedSeg6 = gSegments[6];
+    gSegments[6] = K0_TO_PHYS(CF_EXP_AREA6);
+    if (gPlayState != PLAY_PAUSE) {
+        Lib_Texture_Scroll(aA6GorgonLaserTex, 16, 16, 0);
+    }
+    gSPSegment(gMasterDisp++, 0x06, gSegments[6]);
+
+    Matrix_Push(&gGfxMatrix);
+    Matrix_Translate(gGfxMatrix, sCfOmegaPos.x, sCfOmegaPos.y, sCfOmegaPos.z + gPathProgress, MTXF_APPLY);
+    Matrix_RotateY(gGfxMatrix, Math_Atan2F(sCfOmegaDir.x, sCfOmegaDir.z), MTXF_APPLY);
+    Matrix_RotateX(gGfxMatrix, -Math_Atan2F(sCfOmegaDir.y, sqrtf(SQ(sCfOmegaDir.x) + SQ(sCfOmegaDir.z))),
+                   MTXF_APPLY);
+    Matrix_RotateZ(gGfxMatrix, sCfOmegaSpin * M_DTOR, MTXF_APPLY);
+    Matrix_Scale(gGfxMatrix, width, width, len / 220.0f, MTXF_APPLY);
+    Matrix_SetGfxMtx(&gMasterDisp);
+    RCP_SetupDL(&gMasterDisp, SETUPDL_53);
+    gSPDisplayList(gMasterDisp++, aA6GorgonLaserDL); /* back faces stay culled: half the fill */
+    Matrix_Pop(&gGfxMatrix);
+
+    gSegments[6] = savedSeg6;
+    gSPSegment(gMasterDisp++, 0x06, gSegments[6]);
+}
diff --git a/src/mods/customfox_save.inc.c b/src/mods/customfox_save.inc.c
new file mode 100644
index 0000000..2d0cbe0
--- /dev/null
+++ b/src/mods/customfox_save.inc.c
@@ -0,0 +1,86 @@
+/*
+ * Custom Fox 64 - extended save data.
+ * #included at the end of src/engine/fox_save.c.
+ *
+ * The EEPROM holds the save twice (a main copy and a backup). Custom Fox 64 keeps the
+ * main copy as the game expects it and uses the backup half for extra data instead:
+ * the full hit count (0-9999) of every mission in the ranking. The original 9-bit
+ * per-mission hit fields are still written (capped at 511) so the save stays valid.
+ */
+
+#define CF_SAVE_EXT_MAGIC 0xCF
+#define CF_SAVE_EXT_VERSION 1
+#define CF_MAX_MISSION_HITS 9999
+
+u16 gCfRankHits[RANKING_MAX][ROUTE_MAX];
+
+static s32 CustomFox_VanillaRankHits(s32 rank, s32 route) {
+    return gSaveFile.save.data.stats[rank][route].hitCount |
+           ((gSaveFile.save.data.stats[rank][route].hitCountOver256 & 1) << 8);
+}
+
+/* Full hit count of one mission in the ranking. Falls back to the original field if they disagree. */
+s32 CustomFox_RankHits(s32 rank, s32 route) {
+    s32 base = CustomFox_VanillaRankHits(rank, route);
+    s32 ext = gCfRankHits[rank][route];
+
+    if ((ext == base) || ((base == 511) && (ext > 511) && (ext <= CF_MAX_MISSION_HITS))) {
+        return ext;
+    }
+    return base;
+}
+
+void CustomFox_SetRankHits(s32 rank, s32 route, s32 hits) {
+    if (hits < 0) {
+        hits = 0;
+    }
+    if (hits > CF_MAX_MISSION_HITS) {
+        hits = CF_MAX_MISSION_HITS;
+    }
+    gCfRankHits[rank][route] = hits;
+}
+
+/* Builds the backup half of the EEPROM from the extended data. */
+static void CustomFox_BuildSaveExt(Save* ext) {
+    s32 i;
+    s32 j;
+    s32 k = 2;
+
+    for (i = 0; i < sizeof(SaveData); i++) {
+        ext->raw[i] = 0;
+    }
+    ext->raw[0] = CF_SAVE_EXT_MAGIC;
+    ext->raw[1] = CF_SAVE_EXT_VERSION;
+    for (i = 0; i < RANKING_MAX; i++) {
+        for (j = 0; j < ROUTE_MAX; j++, k += 2) {
+            s32 hits = CustomFox_RankHits(i, j);
+
+            ext->raw[k] = (hits >> 8) & 0xFF;
+            ext->raw[k + 1] = hits & 0xFF;
+        }
+    }
+    ext->checksum = Save_Checksum(ext);
+}
+
+static bool CustomFox_IsSaveExt(Save* ext) {
+    return (ext->raw[0] == CF_SAVE_EXT_MAGIC) && (ext->raw[1] == CF_SAVE_EXT_VERSION) &&
+           (ext->checksum == Save_Checksum(ext));
+}
+
+/* Loads the extended data (or starts it from the original fields on an older save). */
+static void CustomFox_ReadSaveExt(Save* ext) {
+    s32 i;
+    s32 j;
+    s32 k = 2;
+    bool valid = CustomFox_IsSaveExt(ext);
+
+    for (i = 0; i < RANKING_MAX; i++) {
+        for (j = 0; j < ROUTE_MAX; j++, k += 2) {
+            if (valid) {
+                gCfRankHits[i][j] = (ext->raw[k] << 8) | ext->raw[k + 1];
+            } else {
+                gCfRankHits[i][j] = CustomFox_VanillaRankHits(i, j);
+            }
+        }
+    }
+}
