diff --git a/src/mods/customfox.inc.c b/src/mods/customfox.inc.c
new file mode 100644
index 0000000..372a160
--- /dev/null
+++ b/src/mods/customfox.inc.c
@@ -0,0 +1,610 @@
+/*
+ * Custom Fox 64 - gameplay side of the cheat menu.
+ * This file is #included at the bottom of src/engine/fox_play.c so it is
+ * part of the main code segment and visible to every overlay.
+ */
+
+#include "mods.h"
+
+u8 gCustomFox[CF_MAX];
+
+static s32 sCustomFoxRapidTimer = 0;
+
+/* Save layout: padEE[0] = magic, [1,2,4] = cheat bits (LSB first), [3] = ship, [5] = Misc bits,
+ * [6,7] = unlock progress, [8] = progress format mark. */
+#define CF_PROGRESS_MARK 0x5A
+static void CustomFox_LoadFromSaveInner(void) {
+    s32 i;
+    u32 bits;
+
+    if ((u8) gSaveFile.save.data.padEE[0] != CF_SAVE_MAGIC) {
+        for (i = 0; i < CF_MAX; i++) {
+            gCustomFox[i] = 0;
+        }
+        gCustomFoxShip = CFSHIP_ARWING;
+        for (i = 0; i < CFMISC_MAX; i++) {
+            gCustomFoxMisc[i] = 0;
+        }
+        return;
+    }
+    bits = (u8) gSaveFile.save.data.padEE[1] | ((u8) gSaveFile.save.data.padEE[2] << 8);
+    bits |= (u8) gSaveFile.save.data.padEE[4] << 16;
+    gCustomFoxShip = (u8) gSaveFile.save.data.padEE[3];
+    if (gCustomFoxShip >= CFSHIP_SELECTABLE) {
+        gCustomFoxShip = CFSHIP_ARWING;
+    }
+    for (i = 0; i < CF_MAX; i++) {
+        gCustomFox[i] = (bits >> i) & 1;
+    }
+    for (i = 0; i < CFMISC_MAX; i++) {
+        gCustomFoxMisc[i] = ((u8) gSaveFile.save.data.padEE[5] >> i) & 1;
+    }
+}
+
+
+/* ======================================================================
+ * Unlocks
+ * Progress bits live in padEE[6..7]. Andross, Katina and Zoness clears that the game
+ * itself saved (planet clear flags) count too, so existing saves keep what they earned.
+ * Clearing a harder difficulty also counts for the easier ones; Master and Andross's
+ * Revenge count as Expert.
+ * ====================================================================== */
+
+u32 CustomFox_Progress(void) {
+    PlanetData* planet = gSaveFile.save.data.planet;
+    u32 p = 0;
+
+    if (((u8) gSaveFile.save.data.padEE[0] == CF_SAVE_MAGIC) &&
+        ((u8) gSaveFile.save.data.padEE[8] == CF_PROGRESS_MARK)) {
+        p = (u8) gSaveFile.save.data.padEE[6] | ((u8) gSaveFile.save.data.padEE[7] << 8);
+    }
+    if (planet[SAVE_SLOT_VENOM_1].normalClear || planet[SAVE_SLOT_VENOM_2].normalClear) {
+        p |= 1 << CFP_ANDROSS_NORMAL;
+    }
+    if (planet[SAVE_SLOT_VENOM_1].expertClear || planet[SAVE_SLOT_VENOM_2].expertClear) {
+        p |= 1 << CFP_ANDROSS_EXPERT;
+    }
+    if (planet[PLANET_ZONESS].normalClear) {
+        p |= 1 << CFP_KATT;
+    }
+    if (planet[PLANET_ZONESS].expertClear) {
+        p |= 1 << CFP_KATT_EXPERT;
+    }
+    /* a harder clear counts for the easier ones */
+    if (p & (1 << CFP_ANDROSS_REVENGE)) {
+        p |= 1 << CFP_ANDROSS_MASTER;
+    }
+    if (p & (1 << CFP_ANDROSS_MASTER)) {
+        p |= 1 << CFP_ANDROSS_EXPERT;
+    }
+    if (p & (1 << CFP_ANDROSS_EXPERT)) {
+        p |= 1 << CFP_ANDROSS_NORMAL;
+    }
+    if (p & (1 << CFP_BILL_EXPERT)) {
+        p |= 1 << CFP_BILL;
+    }
+    if (p & (1 << CFP_KATT_EXPERT)) {
+        p |= 1 << CFP_KATT;
+    }
+    if (p & (1 << CFP_WOLF_EXPERT)) {
+        p |= 1 << CFP_WOLF;
+    }
+    return p;
+}
+
+/* Every mission (all 16 save slots, both Venom routes included) cleared on Normal. */
+bool CustomFox_AllNormalMissions(void) {
+    s32 i;
+
+    for (i = 0; i < 16; i++) {
+        if (!gSaveFile.save.data.planet[i].normalClear) {
+            return false;
+        }
+    }
+    return true;
+}
+
+#define CF_HAS(bit) ((CustomFox_Progress() & (1 << (bit))) != 0)
+
+bool CustomFox_CheatUnlocked(s32 cheat) {
+    return (cheat == CF_UNLOCK_ALL) || gCustomFox[CF_UNLOCK_ALL] || CF_HAS(CFP_ANDROSS_NORMAL);
+}
+
+bool CustomFox_ShipUnlocked(s32 ship) {
+    if ((ship == CFSHIP_ARWING) || gCustomFox[CF_UNLOCK_ALL]) {
+        return true;
+    }
+    switch (ship) {
+        case CFSHIP_ARWING_MK2:
+            return CF_HAS(CFP_ANDROSS_EXPERT);
+        case CFSHIP_WOLFEN:
+            return CF_HAS(CFP_WOLF);
+        case CFSHIP_WOLFEN_II:
+            return CF_HAS(CFP_WOLF_EXPERT);
+        case CFSHIP_KATT:
+            return CF_HAS(CFP_KATT);
+        case CFSHIP_KATT_MK2:
+            return CF_HAS(CFP_KATT_EXPERT);
+        case CFSHIP_BILL:
+            return CF_HAS(CFP_BILL);
+        case CFSHIP_BILL_MK2:
+            return CF_HAS(CFP_BILL_EXPERT);
+        case CFSHIP_GREAT_FOX:
+            return CF_HAS(CFP_ANDROSS_REVENGE);
+        default:
+            return false;
+    }
+}
+
+bool CustomFox_MiscUnlocked(s32 misc) {
+    if ((misc == CFMISC_SKIP_CUTSCENES) || gCustomFox[CF_UNLOCK_ALL]) {
+        return true;
+    }
+    switch (misc) {
+        case CFMISC_HARD_MODE: /* Master */
+            return CF_HAS(CFP_ANDROSS_EXPERT);
+        case CFMISC_ANDROSS_REVENGE:
+        case CFMISC_MORE_ENEMIES:
+            return CF_HAS(CFP_ANDROSS_MASTER);
+        case CFMISC_TRIPLE_ENEMIES:
+            return CF_HAS(CFP_ANDROSS_REVENGE);
+        case CFMISC_VEHICLES:
+            return CF_HAS(CFP_ANDROSS_NORMAL);
+        case CFMISC_ANY_PATH:
+            return CustomFox_AllNormalMissions();
+        default:
+            return false;
+    }
+}
+
+/* Turns off anything that is switched on but not unlocked (old saves, or Unlock All turned off). */
+void CustomFox_ApplyLocks(void) {
+    s32 i;
+
+    for (i = 0; i < CF_MAX; i++) {
+        if (!CustomFox_CheatUnlocked(i)) {
+            gCustomFox[i] = 0;
+        }
+    }
+    for (i = 0; i < CFMISC_MAX; i++) {
+        if (!CustomFox_MiscUnlocked(i)) {
+            gCustomFoxMisc[i] = 0;
+        }
+    }
+    if (!CustomFox_ShipUnlocked(gCustomFoxShip)) {
+        gCustomFoxShip = CFSHIP_ARWING;
+    }
+}
+
+void CustomFox_SetProgress(s32 bit) {
+    if (gVersusMode) {
+        return;
+    }
+    CustomFox_StoreToSave(); /* makes sure the magic and the progress bytes are valid */
+    if (bit < 8) {
+        gSaveFile.save.data.padEE[6] |= 1 << bit;
+    } else {
+        gSaveFile.save.data.padEE[7] |= 1 << (bit - 8);
+    }
+}
+
+/* Andross is beaten (end of the escape). Saved with the rest of the ending. */
+void CustomFox_RecordAndross(void) {
+    if (CustomFox_IsRevenge()) {
+        CustomFox_SetProgress(CFP_ANDROSS_REVENGE);
+    } else if (CustomFox_IsHard()) {
+        CustomFox_SetProgress(CFP_ANDROSS_MASTER);
+    } else if (gExpertMode) {
+        CustomFox_SetProgress(CFP_ANDROSS_EXPERT);
+    } else {
+        CustomFox_SetProgress(CFP_ANDROSS_NORMAL);
+    }
+}
+
+/* From the map after a mission, right before it saves. */
+void CustomFox_RecordLevel(s32 level, s32 missionStatus) {
+    bool expert = gExpertMode || CustomFox_IsHard();
+
+    switch (level) {
+        case LEVEL_KATINA:
+            if (missionStatus == MISSION_ACCOMPLISHED) {
+                CustomFox_SetProgress(expert ? CFP_BILL_EXPERT : CFP_BILL);
+            }
+            break;
+        case LEVEL_ZONESS:
+            if ((missionStatus == MISSION_ACCOMPLISHED) || (missionStatus == MISSION_COMPLETE)) {
+                CustomFox_SetProgress(expert ? CFP_KATT_EXPERT : CFP_KATT);
+            }
+            break;
+        case LEVEL_FORTUNA:
+            if (missionStatus == MISSION_ACCOMPLISHED) { /* all of Star Wolf shot down */
+                CustomFox_SetProgress(expert ? CFP_WOLF_EXPERT : CFP_WOLF);
+            }
+            break;
+    }
+}
+
+void CustomFox_LoadFromSave(void) {
+    CustomFox_LoadFromSaveInner();
+    CustomFox_ApplyLocks();
+#if CF_TEST_DEFAULTS == 1
+    gCustomFox[CF_INF_HEALTH] = gCustomFox[CF_NOCLIP] = gCustomFox[CF_MAX_LASER] = 1;
+#ifdef CF_TEST_EXTRA
+    gCustomFox[CF_TEST_EXTRA] = 1;
+#endif
+#ifdef CF_TEST_EXTRA2
+    gCustomFox[CF_TEST_EXTRA2] = 1;
+#endif
+#endif
+}
+
+void CustomFox_StoreToSave(void) {
+    s32 i;
+    u32 bits = 0;
+
+    for (i = 0; i < CF_MAX; i++) {
+        if (gCustomFox[i]) {
+            bits |= 1 << i;
+        }
+    }
+    if (((u8) gSaveFile.save.data.padEE[0] != CF_SAVE_MAGIC) ||
+        ((u8) gSaveFile.save.data.padEE[8] != CF_PROGRESS_MARK)) {
+        /* first time: start with no unlock progress (these bytes were never written before) */
+        gSaveFile.save.data.padEE[6] = gSaveFile.save.data.padEE[7] = 0;
+        gSaveFile.save.data.padEE[8] = CF_PROGRESS_MARK;
+    }
+    gSaveFile.save.data.padEE[0] = CF_SAVE_MAGIC;
+    gSaveFile.save.data.padEE[1] = bits & 0xFF;
+    gSaveFile.save.data.padEE[2] = (bits >> 8) & 0xFF;
+    gSaveFile.save.data.padEE[3] = gCustomFoxShip;
+    gSaveFile.save.data.padEE[4] = (bits >> 16) & 0xFF;
+    bits = 0;
+    for (i = 0; i < CFMISC_MAX; i++) {
+        if (gCustomFoxMisc[i]) {
+            bits |= 1 << i;
+        }
+    }
+    gSaveFile.save.data.padEE[5] = bits;
+}
+
+/* Called once per frame at the top of Play_Update. */
+void CustomFox_PlayUpdate(void) {
+    Player* player = &gPlayer[0];
+    s32 i;
+
+    if (gVersusMode) {
+        return;
+    }
+
+    CustomFox_ShipUpdate();
+    CustomFox_MoreEnemiesUpdate();
+    CustomFox_VehicleUpdate();
+    CustomFox_BurstUpdate();
+    CustomFox_AutoCollect(player);
+    CustomFox_OmegaUpdate(player);
+
+#if CF_TEST_DEFAULTS == 1 /* test builds only: L+R jumps to the ending, like beating Andross */
+    if (((gControllerHold[gMainController].button & (L_TRIG | R_TRIG)) == (L_TRIG | R_TRIG)) &&
+        (gControllerPress[gMainController].button & (L_TRIG | R_TRIG)) && (gNextGameState != GSTATE_ENDING)) {
+        gNextGameState = GSTATE_ENDING; /* the ending overlay's state starts at 0 when it loads */
+        AUDIO_SET_SPEC(SFX_LAYOUT_DEFAULT, AUDIOSPEC_ENDING);
+    }
+#endif
+#if CF_TEST_DEFAULTS == 1 /* test builds only: L hits Granga's backpack for 15 through the normal path */
+    if ((gControllerPress[gMainController].button & L_TRIG) && !(gControllerHold[gMainController].button & R_CBUTTONS) &&
+        (gCurrentLevel == LEVEL_CORNERIA) &&
+        (gBosses[0].obj.status == OBJ_ACTIVE) && (gBosses[0].obj.id == OBJ_BOSS_CO_GRANGA)) {
+        gBosses[0].dmgType = DMG_BEAM;
+        gBosses[0].damage = 15;
+        gBosses[0].dmgPart = 0; /* GRANGA_DMG_BACKPACK */
+    }
+#endif
+
+#if MODS_FULL_SAVE == 1 /* test builds only: L deals a 20 damage hit */
+    if ((gControllerPress[gMainController].button & L_TRIG) && (player->state == PLAYERSTATE_ACTIVE)) {
+        Player_ApplyDamage(player, 0, 20);
+    }
+#endif
+
+    if (CF_ON(CF_INF_BOMBS)) {
+        gBombCount[0] = 9;
+    }
+
+    if (CF_ON(CF_INF_LIVES) && (gLifeCount[0] < 1)) {
+        gLifeCount[0] = 1;
+    }
+
+    if (CF_ON(CF_MAX_LASER)) {
+        gLaserStrength[0] = LASERS_HYPER;
+    }
+
+    if (CF_ON(CF_INF_HEALTH) && (player->state != PLAYERSTATE_DOWN) && (player->state != PLAYERSTATE_NEXT)) {
+        player->shields = Play_GetMaxShields();
+        player->damage = 0;
+        if (player->form == FORM_ARWING) {
+            gRightWingHealth[0] = 60;
+            gLeftWingHealth[0] = 60;
+            if ((player->arwing.rightWingState <= WINGSTATE_BROKEN) ||
+                (player->arwing.leftWingState <= WINGSTATE_BROKEN)) {
+                Player_RepairWings();
+            }
+        }
+    }
+
+    if (CF_ON(CF_INF_BOOST) && !CustomFox_IsGreatFox(player)) {
+        player->boostMeter = 0.0f;
+        player->boostCooldown = false;
+    }
+
+    if (CF_ON(CF_ALLY_HEALTH)) {
+        for (i = TEAM_ID_FALCO; i <= TEAM_ID_PEPPY; i++) {
+            gTeamDamage[i] = 0;
+            if (gTeamShields[i] > 0) {
+                gTeamShields[i] = 255;
+            }
+        }
+    }
+
+    if (CF_ON(CF_MAX_HITS)) {
+        gHitCount = 9999;
+        gDisplayedHitCount = 9999;
+    }
+}
+
+/* Called at the end of Play_Update, after kills have added to the hit counter. */
+void CustomFox_PlayUpdateLate(void) {
+    if (CF_ON(CF_INF_BOOST) && !CustomFox_IsGreatFox(&gPlayer[0])) {
+        gPlayer[0].boostMeter = 0.0f;
+        gPlayer[0].boostCooldown = false;
+    }
+    if (CF_ON(CF_MAX_HITS)) {
+        gHitCount = 9999;
+        gDisplayedHitCount = 9999;
+    }
+}
+
+/* Called right after the hit counter is set up at the start of a level. */
+void CustomFox_LevelStartHits(void) {
+    CustomFox_ShipLevelStart();
+    CustomFox_ModesLevelStart();
+    if (CF_ON(CF_START_150_HITS) && (gHitCount < 150)) {
+        gHitCount = 150;
+        gDisplayedHitCount = 150;
+    }
+    if (CF_ON(CF_MAX_HITS)) {
+        gHitCount = 9999;
+        gDisplayedHitCount = 9999;
+    }
+}
+
+static void CustomFox_FireChargedShot(Player* player) {
+    s32 i;
+
+    if (CustomFox_FireMultiCharged(player)) {
+        return;
+    }
+
+    /* Slots 0-13 are general purpose, 14 is the normal charge slot, 15 is the bomb. */
+    for (i = 0; i < 15; i++) {
+        if (gPlayerShots[i].obj.status == SHOT_FREE) {
+            if (player->form == FORM_ARWING) {
+                Player_SetupArwingShot(player, &gPlayerShots[i], 0.0f, 0.0f, PLAYERSHOT_LOCK_ON, 70.0f);
+            } else {
+                Player_SetupTankShot(player, &gPlayerShots[i], PLAYERSHOT_LOCK_ON, 70.0f);
+            }
+            Object_PlayerSfx(player->sfxSource, NA_SE_LOCK_ON_LASER, player->num);
+            gControllerRumbleTimers[player->num] = 3;
+            return;
+        }
+    }
+}
+
+/*
+ * Rapid fire + auto charge cheat: holding A fires a fast stream of lasers. While A is
+ * not held the laser charges by itself; the next press fires the charged shot (at every
+ * multi-lock target if a multi-lock is active).
+ */
+static s32 sCfAutoFireTimer = 0;
+static bool sCfAutoCharged = false; /* stays charged after the charge locks onto an enemy */
+
+static bool CustomFox_AnyLocked(void) {
+    s32 i;
+
+    for (i = 0; i < ARRAY_COUNT(gActors); i++) {
+        if ((gActors[i].obj.status == OBJ_ACTIVE) && (gActors[i].lockOnTimers[0] != 0)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void CustomFox_AutoFireLaser(Player* player) {
+    if (player->form == FORM_ARWING) {
+        Player_ArwingLaser(player);
+        sCfAutoFireTimer = 3;
+    } else {
+        Player_TankCannon(player);
+        sCfAutoFireTimer = 6;
+    }
+}
+
+static bool CustomFox_RapidAuto(Player* player) {
+    s32 i;
+
+    if (gInputPress->button & A_BUTTON) {
+        if (sCfAutoCharged || (gChargeTimers[0] >= 20) || CustomFox_AnyLocked()) {
+            CustomFox_RememberLocks(); /* the lasers that follow keep chasing these */
+            CustomFox_FireChargedShot(player);
+            sCfAutoFireTimer = (player->form == FORM_ARWING) ? 3 : 6;
+        } else {
+            CustomFox_AutoFireLaser(player);
+        }
+        sCfAutoCharged = false;
+        gChargeTimers[0] = 0;
+    } else if (gInputHold->button & A_BUTTON) {
+        gChargeTimers[0] = 0;
+        sCfAutoCharged = false;
+        if (sCfAutoFireTimer > 0) {
+            sCfAutoFireTimer--;
+        }
+        if (sCfAutoFireTimer == 0) {
+            CustomFox_AutoFireLaser(player);
+        }
+    } else {
+        if (!sCfAutoCharged) {
+            gChargeTimers[0]++;
+            if (gChargeTimers[0] >= 20) {
+                gChargeTimers[0] = 21;
+                sCfAutoCharged = true;
+                Object_PlayerSfx(player->sfxSource, NA_SE_LOCK_SEARCH, player->num);
+            }
+        } else if (!CustomFox_AnyLocked()) {
+            gChargeTimers[0] = 21; /* keep the charge glow until something is locked */
+        }
+        if (sCfAutoCharged) {
+            /* locks held while charged don't time out */
+            for (i = 0; i < ARRAY_COUNT(gActors); i++) {
+                if ((gActors[i].obj.status == OBJ_ACTIVE) && (gActors[i].lockOnTimers[0] != 0)) {
+                    gActors[i].lockOnTimers[0] = 20;
+                }
+            }
+            /* a ready charge keeps sweeping for targets so it homes in */
+            if (CustomFox_MultiLockCount() > 0) {
+                CustomFox_MultiLockUpdate(player);
+            } else if (((gGameFrameCount % 4) == 0) && Player_CanLockOn(player->num)) {
+                for (i = 0; i < 13; i++) {
+                    if (gPlayerShots[i].obj.status == SHOT_FREE) {
+                        if (player->form == FORM_ARWING) {
+                            Player_SetupArwingShot(player, &gPlayerShots[i], 0.0f, 0.0f, PLAYERSHOT_LOCK_SEARCH,
+                                                   400.0f);
+                        } else {
+                            Player_SetupTankShot(player, &gPlayerShots[i], PLAYERSHOT_LOCK_SEARCH, 400.0f);
+                        }
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    return true;
+}
+
+/*
+ * Replacement firing logic for the charged-laser cheats.
+ * Returns true when it handled the A button (normal lasers are skipped).
+ */
+bool CustomFox_Shoot(Player* player) {
+    s32 i;
+    bool fire = false;
+
+    if ((player->num == 0) && CF_ON(CF_RAPID_AUTO)) {
+        return CustomFox_RapidAuto(player);
+    }
+    if ((player->num != 0) || gVersusMode || (!CF_ON(CF_CHARGED_LASER) && !CF_ON(CF_RAPID_CHARGED))) {
+        return false;
+    }
+
+    if (gInputPress->button & A_BUTTON) {
+        fire = true;
+        sCustomFoxRapidTimer = 6;
+    } else if (CF_ON(CF_RAPID_CHARGED) && (gInputHold->button & A_BUTTON)) {
+        if (sCustomFoxRapidTimer > 0) {
+            sCustomFoxRapidTimer--;
+        }
+        if (sCustomFoxRapidTimer == 0) {
+            fire = true;
+            sCustomFoxRapidTimer = 6;
+        }
+    }
+
+    /* Holding A still sweeps for lock-on targets so the charged shots home in. */
+    if ((gInputHold->button & A_BUTTON) && (CustomFox_MultiLockCount() > 0)) {
+        CustomFox_MultiLockUpdate(player);
+    } else if ((gInputHold->button & A_BUTTON) && ((gGameFrameCount % 4) == 0) && Player_CanLockOn(player->num)) {
+        for (i = 0; i < 13; i++) {
+            if (gPlayerShots[i].obj.status == SHOT_FREE) {
+                if (player->form == FORM_ARWING) {
+                    Player_SetupArwingShot(player, &gPlayerShots[i], 0.0f, 0.0f, PLAYERSHOT_LOCK_SEARCH, 400.0f);
+                } else {
+                    Player_SetupTankShot(player, &gPlayerShots[i], PLAYERSHOT_LOCK_SEARCH, 400.0f);
+                }
+                break;
+            }
+        }
+    }
+
+    if (fire) {
+        CustomFox_FireChargedShot(player);
+    }
+
+    return (gInputHold->button & A_BUTTON) || (gInputPress->button & A_BUTTON);
+}
+
+/* No Clip: pass through objects, but never sink under the ground, water or lava. */
+void CustomFox_NoClipFloor(Player* player) {
+    f32 floorY = gGroundHeight;
+    f32 dynaY;
+    f32 margin;
+    s32 tri;
+
+    if (gGroundType == GROUND_4) {
+        return;
+    }
+    if (gUseDynaFloor && Play_CheckDynaFloorCollision(&dynaY, &tri, player->pos.x, player->pos.y - 20.0f,
+                                                      player->trueZpos)) {
+        if (dynaY > floorY) {
+            floorY = dynaY;
+        }
+    }
+    margin = CustomFox_IsGreatFox(player) ? 90.0f : 20.0f;
+    if (player->pos.y < (floorY + margin)) {
+        player->pos.y = floorY + margin;
+        if (player->vel.y < 0.0f) {
+            player->vel.y = 0.0f;
+        }
+    }
+}
+
+s32 CustomFox_ScaleDamage(s32 damage, s32 sourceId) {
+    if ((sourceId != 0) || gVersusMode || (damage <= 0)) {
+        return damage;
+    }
+    if (gCfOmegaHitting) {
+        damage *= CF_OMEGA_DAMAGE_MULT; /* Omega Laser: 8x a laser hit */
+    }
+    /* Aquas uses damage values 30/31 as special flags; leave them alone. */
+    if ((gCurrentLevel == LEVEL_AQUAS) && ((damage == 30) || (damage == 31))) {
+        return damage;
+    }
+    if (CF_ON(CF_DAMAGE_4X)) {
+        return damage * 4;
+    }
+    if (CF_ON(CF_DAMAGE_2X)) {
+        return damage * 2;
+    }
+    return damage;
+}
+
+void CustomFox_VehicleUpdate(void);
+
+f32 CustomFox_BombRadiusScale(PlayerShot* shot) {
+    if (CF_ON(CF_BOMB_4X) && (shot->obj.id == PLAYERSHOT_BOMB) && (shot->sourceId == 0)) {
+        return 4.0f;
+    }
+    if ((gCurrentLevel == LEVEL_AQUAS) && (shot->obj.id == PLAYERSHOT_LOCK_ON) && (shot->sourceId == 0) &&
+        CustomFox_VehicleUpgrades()) {
+        return 4.0f; /* Blue Marine torpedoes */
+    }
+    return CustomFox_ShipBlastScale(shot); /* MK2: charged-shot blasts are twice as wide */
+}
+
+bool CustomFox_IsAlly(Actor* actor) {
+    if (actor->obj.id == OBJ_ACTOR_EVENT) {
+        return (actor->iwork[EVA_TEAM_ID] >= TEAM_ID_FALCO) && (actor->iwork[EVA_TEAM_ID] <= TEAM_ID_BILL);
+    }
+    if ((actor->obj.id == OBJ_ACTOR_ALLRANGE) || (actor->obj.id == OBJ_ACTOR_TEAM_BOSS)) {
+        return ((actor->aiType >= AI360_FALCO) && (actor->aiType <= AI360_PEPPY)) || (actor->aiType == AI360_KATT) ||
+               (actor->aiType == AI360_BILL);
+    }
+    return false;
+}
