+/* Vehicle Upgrades: the Blue Marine keeps up to 3 targets in front of it locked (red boxes). */
+#define CF_MARINE_LOCKS 3
+s32 CustomFox_MarineTargets(Player* player, Actor** out) {
+    s32 n = CustomFox_FindTargets(player, out, CF_MARINE_LOCKS);
+    s32 i;
+
+    for (i = 0; i < n; i++) {
+        out[i]->lockOnTimers[player->num] = 5;
+    }
+    return n;
+}
+
+void CustomFox_ClearShotTarget(PlayerShot* shot) {
+    s32 i = shot - gPlayerShots;
+
+    if ((i >= 0) && (i < ARRAY_COUNT(sCfShotTarget))) {
+        sCfShotTarget[i] = NULL;
+    }
+}
