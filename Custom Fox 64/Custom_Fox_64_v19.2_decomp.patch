+/* Small pips to the right of the shield gauge: one per shield hit. */
+void CustomFox_DrawShieldPips(f32 x, f32 y) {
+    s32 max = CustomFox_ShieldMax();
+    s32 i;
+    s32 px;
+    bool flash;
+
+    if (CustomFox_IsRevenge()) { /* green shield dot(s) first, they take hits first */
+        flash = (sCfGreenHits < CF_GREEN_SHIELDS) && (sCfGreenTimer > (CF_GREEN_RECHARGE_FRAMES - 30)) &&
+                ((gGameFrameCount & 2) != 0);
+        for (i = 0; i < CF_GREEN_SHIELDS; i++) {
+            px = (s32) x;
+            flash = (i == sCfGreenHits) && (sCfGreenTimer > (CF_GREEN_RECHARGE_FRAMES - 30)) && ((gGameFrameCount & 2) != 0);
+            if ((i < sCfGreenHits) || flash) {
+                Graphics_FillRectangle(&gMasterDisp, px, (s32) y + 2, px + 5, (s32) y + 8, 40, 255, 40, 255);
+                Graphics_FillRectangle(&gMasterDisp, px + 1, (s32) y + 1, px + 4, (s32) y + 9, 40, 255, 40, 255);
+            } else {
+                Graphics_FillRectangle(&gMasterDisp, px, (s32) y + 2, px + 5, (s32) y + 8, 40, 70, 40, 255);
+            }
+            x += 8.0f;
+        }
+    }
+    if ((max == 0) || (gPlayer[0].num != 0)) {
+        return;
+    }
+    flash = (sCfShieldHits < max) && (sCfShieldTimer > (CF_SHIELD_RECHARGE_FRAMES - 30)) && ((gGameFrameCount & 2) != 0);
+
+    for (i = 0; i < max; i++) {
+        px = (s32) x + i * 7;
+        if ((i < sCfShieldHits) || flash) {
+            Graphics_FillRectangle(&gMasterDisp, px, (s32) y + 2, px + 4, (s32) y + 8, 0, 230, 255, 255);
+        } else {
+            Graphics_FillRectangle(&gMasterDisp, px, (s32) y + 2, px + 4, (s32) y + 8, 60, 60, 80, 255);
+        }
+    }
+}
