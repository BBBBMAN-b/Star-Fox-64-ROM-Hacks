+static void CustomFoxMenu_Toggle(s32 cheat) {
+    if (!CustomFox_CheatUnlocked(cheat)) {
+        AUDIO_PLAY_SFX(NA_SE_ERROR, gDefaultSfxSource, 4);
+        return;
+    }
+    gCustomFox[cheat] ^= 1;
+    if ((cheat == CF_UNLOCK_ALL) && !gCustomFox[cheat]) {
+        CustomFox_ApplyLocks(); /* anything only Unlock All allowed goes back off */
+    }
+    if (gCustomFox[cheat]) {
+        if (cheat == CF_DAMAGE_2X) {
+            gCustomFox[CF_DAMAGE_4X] = 0;
+        } else if (cheat == CF_DAMAGE_4X) {
+            gCustomFox[CF_DAMAGE_2X] = 0;
+        }
+        if (cheat == CF_RAPID_AUTO) { /* the charged-laser cheats each take over the A button */
+            gCustomFox[CF_CHARGED_LASER] = gCustomFox[CF_RAPID_CHARGED] = 0;
+        } else if ((cheat == CF_CHARGED_LASER) || (cheat == CF_RAPID_CHARGED)) {
+            gCustomFox[CF_RAPID_AUTO] = 0;
+        }
+        if ((cheat >= CF_MULTI_LOCK_3) && (cheat <= CF_MULTI_LOCK_12)) { /* only one multi-lock at a time */
+            gCustomFox[CF_MULTI_LOCK_3] = gCustomFox[CF_MULTI_LOCK_5] = gCustomFox[CF_MULTI_LOCK_7] =
+                gCustomFox[CF_MULTI_LOCK_12] = 0;
+            gCustomFox[cheat] = 1;
+        }
+        AUDIO_PLAY_SFX(NA_SE_DECIDE, gDefaultSfxSource, 4);
+    } else {
+        AUDIO_PLAY_SFX(NA_SE_CANCEL, gDefaultSfxSource, 4);
+    }
+}
+
+static void CustomFoxMenu_UpdateCheats(void) {
+    u16 press = gControllerPress[gMainController].button;
+    s32 i;
+    s32 allOn;
+
+    if (CustomFoxMenu_MoveCursor(&sCfCheatCursor, CF_MAX - 1)) {
+        AUDIO_PLAY_SFX(NA_SE_CURSOR, gDefaultSfxSource, 4);
+    }
+
+    if (sCfCheatCursor < sCfScroll) {
+        sCfScroll = sCfCheatCursor;
+    }
+    if (sCfCheatCursor >= sCfScroll + CF_VISIBLE_ROWS) {
+        sCfScroll = sCfCheatCursor - CF_VISIBLE_ROWS + 1;
+    }
+
+    if (press & (A_BUTTON | L_JPAD | R_JPAD)) {
+        CustomFoxMenu_Toggle(sCfCheatOrder[sCfCheatCursor]);
+    }
+
+    if (press & R_TRIG) { /* every unlocked cheat on or off (Unlock All keeps its own setting) */
+        allOn = true;
+        for (i = 0; i < CF_MAX; i++) {
+            if ((i != CF_DAMAGE_2X) && (i != CF_MULTI_LOCK_3) && (i != CF_MULTI_LOCK_5) && (i != CF_MULTI_LOCK_7) &&
+                (i != CF_RAPID_AUTO) && (i != CF_UNLOCK_ALL) && !gCustomFox[i] && CustomFox_CheatUnlocked(i)) {
+                allOn = false;
+            }
+        }
+        for (i = 0; i < CF_MAX; i++) {
+            if ((i != CF_UNLOCK_ALL) && CustomFox_CheatUnlocked(i)) {
+                gCustomFox[i] = !allOn;
+            }
+        }
+        gCustomFox[CF_DAMAGE_2X] = 0; /* x4 and lock 12 win when everything is turned on */
+        gCustomFox[CF_MULTI_LOCK_3] = gCustomFox[CF_MULTI_LOCK_5] = gCustomFox[CF_MULTI_LOCK_7] = 0;
+        gCustomFox[CF_RAPID_AUTO] = 0;
+        if (allOn) {
+            gCustomFox[CF_DAMAGE_4X] = 0;
+            AUDIO_PLAY_SFX(NA_SE_CANCEL, gDefaultSfxSource, 4);
+        } else {
+            AUDIO_PLAY_SFX(NA_SE_DECIDE, gDefaultSfxSource, 4);
+        }
+    }
+
+    if (press & B_BUTTON) {
+        AUDIO_PLAY_SFX(NA_SE_ARWING_CANCEL, gDefaultSfxSource, 4);
+        CustomFox_StoreToSave();
+        Save_Write();
+        sCfState = CFMENU_HUB;
+        sCfAnim = 0.0f;
+        sDrawCursor = true;
+    }
+}
+
+void CustomFoxMenu_Update(void) {
+    u16 press = gControllerPress[gMainController].button;
+    s32 i;
+
+    if (sCfAnim < 1.0f) {
+        sCfAnim += 0.2f;
+        if (sCfAnim > 1.0f) {
+            sCfAnim = 1.0f;
+        }
+    }
+
+    switch (sCfState) {
+        case CFMENU_HUB:
+            if (CustomFoxMenu_MoveCursor(&sCfHubCursor, 2)) {
+                AUDIO_PLAY_SFX(NA_SE_ARWING_CURSOR, gDefaultSfxSource, 4);
+            }
+            if (press & (A_BUTTON | START_BUTTON)) {
+                AUDIO_PLAY_SFX(NA_SE_ARWING_DECIDE, gDefaultSfxSource, 4);
+                sDrawCursor = false;
+                sCfAnim = 0.0f;
+                sCfStick.unk_0 = 0;
+                sCfStick.unk_4 = 0;
+                switch (sCfHubCursor) {
+                    case 0:
+                        sCfState = CFMENU_CHEATS;
+                        break;
+                    case 1:
+                        sCfState = CFMENU_SHIPSWAP;
+                        sCfShipCursor = 0;
+                        for (i = 0; i < CFSHIP_MAX; i++) {
+                            if (sCfShipOrder[i] == gCustomFoxShip) {
+                                sCfShipCursor = i;
+                            }
+                        }
+                        break;
+                    case 2:
+                        sCfState = CFMENU_MISC;
+                        sCfMiscCursor = 0;
+                        break;
+                }
+            } else if (press & B_BUTTON) {
+                AUDIO_PLAY_SFX(NA_SE_ARWING_CANCEL, gDefaultSfxSource, 4);
+                CustomFoxMenu_Leave();
+            }
+#if CF_TEST_DEFAULTS == 1 /* test builds only: Z on the hub grants the next unlock step */
+            if (press & Z_TRIG) {
+                static s32 sCfTestStep = 0;
+
+                if (sCfTestStep < CFP_MAX) {
+                    CustomFox_SetProgress(sCfTestStep++);
+                    AUDIO_PLAY_SFX(NA_SE_DECIDE, gDefaultSfxSource, 4);
+                }
+            }
+#endif
+            break;
+
+        case CFMENU_CHEATS:
+            CustomFoxMenu_UpdateCheats();
+            break;
+
+        case CFMENU_SHIPSWAP:
+            if (CustomFoxMenu_MoveCursor(&sCfShipCursor, CFSHIP_MAX - 1)) {
+                AUDIO_PLAY_SFX(NA_SE_CURSOR, gDefaultSfxSource, 4);
+            }
+            if (press & A_BUTTON) {
+                if ((sCfShipOrder[sCfShipCursor] < CFSHIP_SELECTABLE) &&
+                    ((sCfShipOrder[sCfShipCursor] == CFSHIP_ARWING) || gCustomFoxShipAssetsLoaded) &&
+                    CustomFox_ShipUnlocked(sCfShipOrder[sCfShipCursor])) {
+                    gCustomFoxShip = sCfShipOrder[sCfShipCursor];
+                    AUDIO_PLAY_SFX(NA_SE_DECIDE, gDefaultSfxSource, 4);
+                } else {
+                    AUDIO_PLAY_SFX(NA_SE_ERROR, gDefaultSfxSource, 4);
+                }
+            }
+            if (press & B_BUTTON) {
+                AUDIO_PLAY_SFX(NA_SE_ARWING_CANCEL, gDefaultSfxSource, 4);
+                CustomFox_StoreToSave();
+                Save_Write();
+                sCfState = CFMENU_HUB;
+                sCfAnim = 0.0f;
+                sDrawCursor = true;
+            }
+            break;
+
+        case CFMENU_MISC:
+            CustomFoxMenu_UpdateMisc();
+            break;
+    }
+}
